      },
      "html": "<style>\n    .uspa-view {\n    --navy: #1B2A4A;\n    --navy-deep: #0F1B33;\n    --navy-soft: #2A3F66;\n    --teal: #0FA3B1;\n    --teal-dark: #0C8793;\n    --gold: #F5A623;\n    --ink: #14213D;\n    --muted: #667085;\n    --line: #DCE3EA;\n    --mist: #F5F7FA;\n    --green: #2ECC71;\n    font-family: 'Geist', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n  }\n  .uspa-view .record-rule { background-image: linear-gradient(to right, rgba(15,163,177,.35) 1px, transparent 1px); background-size: 24px 100%; }\n  .uspa-view .quiet-scroll::-webkit-scrollbar { width: 6px; }\n  .uspa-view .quiet-scroll::-webkit-scrollbar-thumb { background: rgba(15,163,177,.35); border-radius: 999px; }\n  .uspa-view .header-container { max-width: 1180px; }\n  .uspa-view .header-utility > button { min-width: 44px; min-height: 44px; }\n  .uspa-view .section-shell { max-width: 1100px; }\n  .uspa-view .programme-row, .uspa-view .programme-header { min-width: 720px; }\n  @media (max-width: 1023px) {\n    .uspa-view .header-container { height: auto; min-height: 76px; flex-wrap: wrap; padding-top: 1rem; padding-bottom: 1rem; }\n    .uspa-view .header-nav { order: 3; width: 100%; justify-content: center; }\n    .uspa-view .hero-grid { grid-template-columns: 1fr; gap: 2.5rem; }\n    .uspa-view .hero-aside { max-width: 44rem; }\n    .uspa-view .journey-grid { grid-template-columns: 1fr; gap: 3rem; }\n    .uspa-view .cta-grid { grid-template-columns: 1fr; gap: 2rem; }\n  }\n  @media (max-width: 767px) {\n    .uspa-view .header-container { padding-left: 1.25rem; padding-right: 1.25rem; }\n    .uspa-view .brand-subtitle { display: none; }\n    .uspa-view .university-selector { max-width: 15rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n    .uspa-view .header-nav { display: none; }\n    .uspa-view .hero-grid { padding: 4.5rem 1.25rem 3rem; }\n    .uspa-view .hero-title { font-size: clamp(2.75rem, 12vw, 4rem); }\n    .uspa-view .hero-description { font-size: 1rem; line-height: 1.75; }\n    .uspa-view .hero-search { align-items: stretch; flex-direction: column; }\n    .uspa-view .hero-search-button { justify-content: center; }\n    .uspa-view .hero-aside { padding: 1.25rem; }\n    .uspa-view .hero-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); padding-left: 1.25rem; padding-right: 1.25rem; }\n    .uspa-view .hero-stats > div { border-left: 0; padding: .75rem 0; }\n    .uspa-view .featured-header, .uspa-view .faculty-header { align-items: flex-start; flex-direction: column; gap: 1rem; }\n    .uspa-view .faculty-grid { grid-template-columns: 1fr; gap: 0; }\n    .uspa-view .cta-grid { gap: 1.5rem; }\n    .uspa-view .footer-grid { grid-template-columns: 1fr 1fr; gap: 2.5rem 1.5rem; }\n  }\n  @media (max-width: 520px) {\n    .uspa-view .footer-grid { grid-template-columns: 1fr; }\n  }\n</style>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<div class=\"uspa-view min-h-[3000px] bg-white text-[var(--ink)]\" data-kid=\"1\" data-name=\"uspa advisor app view\">\n    <!-- Preserved global header/navigation -->\n    <header class=\"sticky top-0 z-30 border-b border-[var(--line)] bg-white/95 backdrop-blur-sm\" data-kid=\"1-1\" data-name=\"sticky global navigation header\">\n        <div class=\"header-container mx-auto flex h-[76px] max-w-[1180px] items-center justify-between px-8\" data-kid=\"1-1-1\" data-name=\"header content container\">\n            <div class=\"flex items-center gap-7\" data-kid=\"1-1-1-1\" data-name=\"header left group\">\n                <a class=\"flex items-center gap-3 no-underline\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo and name link\" href=\"#\">\n                    <span class=\"flex h-11 w-11 items-center justify-center rounded-[12px] bg-[var(--navy)] text-white shadow-sm\" data-kid=\"1-1-1-1-1-1\" data-name=\"logo icon wrapper\">\n                        <i class=\"h-5 w-5\" data-kid=\"1-1-1-1-1-1-1\" data-lucide=\"graduation-cap\" data-name=\"graduation cap icon\" style=\"width:20px;height:20px;color:#fff\">\n                        </i>\n                    </span>\n                    <span class=\"flex items-baseline gap-2\" data-kid=\"1-1-1-1-1-2\" data-name=\"brand name group\">\n                        <strong class=\"text-[20px] font-bold tracking-[-.03em] text-[var(--ink)]\" data-kid=\"1-1-1-1-1-2-1\" data-name=\"brand name bold text\">\n                            USPA\n                        </strong>\n                        <span class=\"brand-subtitle text-[13px] text-slate-500\" data-kid=\"1-1-1-1-1-2-2\" data-name=\"brand subtitle text\">\n                            Smart Advisor\n                        </span>\n                    </span>\n                </a>\n                <button class=\"university-selector flex h-9 items-center gap-2 rounded-[9px] border border-[var(--line)] bg-[var(--mist)] px-3 text-[13px] font-semibold text-[var(--ink)] shadow-sm\" data-kid=\"1-1-1-1-2\" data-name=\"university selection button\">\n                    <i class=\"h-4 w-4\" data-kid=\"1-1-1-1-2-1\" data-lucide=\"building-2\" data-name=\"university building icon\" style=\"width:16px;height:16px;color:var(--navy)\">\n                    </i>\n                    The University of Bamenda\n                    <i class=\"h-3.5 w-3.5\" data-kid=\"1-1-1-1-2-2\" data-lucide=\"chevron-down\" data-name=\"chevron down icon\" style=\"width:14px;height:14px;color:#667085\">\n                    </i>\n                </button>\n            </div>\n            <nav class=\"header-nav flex items-center gap-1\" data-kid=\"1-1-1-2\" data-name=\"navigation link group\">\n                <a class=\"flex items-center gap-2 rounded-[9px] px-3 py-2 text-[13px] font-semibold text-slate-600 hover:bg-[var(--mist)] hover:text-[var(--ink)]\" data-kid=\"1-1-1-2-1\" data-name=\"programmes navigation link\" href=\"#programmes\">\n                    <i class=\"h-4 w-4\" data-kid=\"1-1-1-2-1-1\" data-lucide=\"book-open\" data-name=\"book open icon\" style=\"width:16px;height:16px;color:var(--navy)\">\n                    </i>\n                    Programmes\n                </a>\n                <a class=\"flex items-center gap-2 rounded-[9px] px-3 py-2 text-[13px] font-semibold text-slate-600 hover:bg-[var(--mist)] hover:text-[var(--ink)]\" data-kid=\"1-1-1-2-2\" data-name=\"faculties navigation link\" href=\"#faculties\">\n                    <i class=\"h-4 w-4\" data-kid=\"1-1-1-2-2-1\" data-lucide=\"landmark\" data-name=\"landmark icon\" style=\"width:16px;height:16px;color:var(--navy)\">\n                    </i>\n                    Faculties\n                </a>\n                <a class=\"flex items-center gap-2 rounded-[9px] px-3 py-2 text-[13px] font-semibold text-slate-600 hover:bg-[var(--mist)] hover:text-[var(--ink)]\" data-kid=\"1-1-1-2-3\" data-name=\"eligibility navigation link\" href=\"#eligibility\">\n                    <i class=\"h-4 w-4\" data-kid=\"1-1-1-2-3-1\" data-lucide=\"graduation-cap\" data-name=\"graduation cap icon\" style=\"width:16px;height:16px;color:var(--navy)\">\n                    </i>\n                    Eligibility\n                </a>\n                <a class=\"flex items-center gap-2 rounded-[9px] px-3 py-2 text-[13px] font-semibold text-slate-600 hover:bg-[var(--mist)] hover:text-[var(--ink)]\" data-kid=\"1-1-1-2-4\" data-name=\"ai advisor navigation link\" href=\"#advisor\">\n                    <i class=\"h-4 w-4\" data-kid=\"1-1-1-2-4-1\" data-lucide=\"bot\" data-name=\"ai robot icon\" style=\"width:16px;height:16px;color:var(--navy)\">\n                    </i>\n                    AI Advisor\n                </a>\n            </nav>\n            <div class=\"header-utility flex items-center gap-2\" data-kid=\"1-1-1-3\" data-name=\"utility buttons group\">\n                <button aria-label=\"Search\" class=\"flex h-10 w-10 items-center justify-center rounded-[9px] text-slate-600 hover:bg-[var(--mist)]\" data-kid=\"1-1-1-3-1\" data-name=\"search button\">\n                    <i class=\"h-5 w-5\" data-kid=\"1-1-1-3-1-1\" data-lucide=\"search\" data-name=\"search icon\" style=\"width:20px;height:20px;color:var(--ink)\">\n                    </i>\n                </button>\n                <button aria-label=\"Toggle theme\" class=\"flex h-10 w-10 items-center justify-center rounded-[9px] text-slate-600 hover:bg-[var(--mist)]\" data-kid=\"1-1-1-3-2\" data-name=\"theme toggle button\">\n                    <i class=\"h-5 w-5\" data-kid=\"1-1-1-3-2-1\" data-lucide=\"moon\" data-name=\"moon icon\" style=\"width:20px;height:20px;color:var(--ink)\">\n                    </i>\n                </button>\n                <a class=\"px-3 py-2 text-[13px] font-semibold text-[var(--ink)] no-underline\" data-kid=\"1-1-1-3-3\" data-name=\"login link\" href=\"#\">\n                    Log in\n                </a>\n                <a class=\"rounded-[9px] bg-[var(--navy)] px-4 py-2.5 text-[13px] font-semibold text-white no-underline shadow-sm\" data-kid=\"1-1-1-3-4\" data-name=\"signup link\" href=\"#\">\n                    Sign up\n                </a>\n            </div>\n        </div>\n    </header>\n    <!-- Hero: one primary action + concise decision rail -->\n    <main data-kid=\"1-2\" data-name=\"main content section\">\n        <section class=\"relative overflow-hidden bg-[var(--navy)] text-white\" data-kid=\"1-2-1\" data-name=\"hero section\">\n            <div class=\"hero-grid mx-auto grid max-w-[1180px] grid-cols-[1.08fr_.92fr] gap-16 px-8 pb-14 pt-20\" data-kid=\"1-2-1-1\" data-name=\"hero content grid\">\n                <div class=\"flex flex-col justify-center\" data-kid=\"1-2-1-1-1\" data-name=\"hero call-to-action block\">\n                    <div class=\"mb-6 flex items-center gap-3 text-[12px] font-semibold uppercase tracking-[.14em] text-[#B8DDE0]\" data-kid=\"1-2-1-1-1-1\" data-name=\"hero top label container\">\n                        <span class=\"h-px w-8 bg-[var(--teal)]\" data-kid=\"1-2-1-1-1-1-1\" data-name=\"hero label horizontal bar\">\n                        </span>\n                        Academic guidance for your next step\n                    </div>\n                    <h1 class=\"hero-title max-w-[680px] text-[56px] font-bold leading-[1.02] tracking-[-.055em] text-white\" data-kid=\"1-2-1-1-1-2\" data-name=\"hero main headline\">\n                        Find your next academic programme with clarity.\n                    </h1>\n                    <p class=\"hero-description mt-6 max-w-[590px] text-[18px] leading-8 text-[#D4DCE8]\" data-kid=\"1-2-1-1-1-3\" data-name=\"hero description text\">\n                        Browse the University of Bamenda catalogue, understand listed requirements, and move forward with a short, evidence-led shortlist.\n                    </p>\n                    <form class=\"mt-9 max-w-[690px]\" data-kid=\"1-2-1-1-1-4\" data-name=\"programme search form\">\n                        <label class=\"mb-2 block text-[12px] font-semibold uppercase tracking-[.12em] text-[#B8DDE0]\" data-kid=\"1-2-1-1-1-4-1\" data-name=\"search form input label\">\n                            Start with a programme, subject, or career\n                        </label>\n                        <div class=\"hero-search flex items-center gap-2 rounded-[12px] border border-white/20 bg-white p-2 shadow-[0_16px_40px_rgba(3,13,35,.22)]\" data-kid=\"1-2-1-1-1-4-2\" data-name=\"search input container\">\n                            <i class=\"ml-3 h-5 w-5 shrink-0\" data-kid=\"1-2-1-1-1-4-2-1\" data-lucide=\"search\" data-name=\"search magnifying glass icon\" style=\"width:20px;height:20px;color:#718096\">\n                            </i>\n                            <input class=\"min-w-0 flex-1 border-0 bg-transparent px-2 py-3 text-[15px] text-[var(--ink)] outline-none\" data-kid=\"1-2-1-1-1-4-2-2\" data-name=\"programme search input field\" placeholder=\"e.g. computer science, biology, accounting\"/>\n                            <button class=\"hero-search-button flex shrink-0 items-center gap-2 rounded-[8px] bg-[var(--teal)] px-5 py-3 text-[14px] font-bold text-white shadow-sm\" data-kid=\"1-2-1-1-1-4-2-3\" data-name=\"find programmes button\" type=\"button\">\n                                <span data-kid=\"1-2-1-1-1-4-2-3-1\" data-name=\"find programmes button text\">\n                                    Find programmes\n                                </span>\n                                <i class=\"h-4 w-4\" data-kid=\"1-2-1-1-1-4-2-3-2\" data-lucide=\"arrow-right\" data-name=\"arrow right icon\" style=\"width:16px;height:16px;color:#fff\">\n                                </i>\n                            </button>\n                        </div>\n                    </form>\n                    <div class=\"mt-5 flex items-center gap-2 text-[12px] text-[#B8C5D8]\" data-kid=\"1-2-1-1-1-5\" data-name=\"disclaimer text container\">\n                        <i class=\"h-4 w-4\" data-kid=\"1-2-1-1-1-5-1\" data-lucide=\"info\" data-name=\"info icon\" style=\"width:16px;height:16px;color:#9DDFE3\">\n                        </i>\n                        <span data-kid=\"1-2-1-1-1-5-2\" data-name=\"disclaimer text\">\n                            Uses listed programme requirements — it is a guide, not an admission decision.\n                        </span>\n                    </div>\n                </div>\n                <aside class=\"hero-aside self-center rounded-[16px] border border-white/15 bg-[#24385D] p-6 shadow-[0_18px_48px_rgba(3,13,35,.24)]\" data-kid=\"1-2-1-1-2\" data-name=\"hero side decision card\">\n                    <div class=\"flex items-start justify-between border-b border-white/10 pb-5\" data-kid=\"1-2-1-1-2-1\" data-name=\"decision card header\">\n                        <div data-kid=\"1-2-1-1-2-1-1\" data-name=\"decision card title group\">\n                            <p class=\"text-[12px] font-semibold uppercase tracking-[.12em] text-[#9DDFE3]\" data-kid=\"1-2-1-1-2-1-1-1\" data-name=\"decision card label text\">\n                                Choose your route\n                            </p>\n                            <h2 class=\"mt-2 text-[24px] font-bold tracking-[-.03em] text-white\" data-kid=\"1-2-1-1-2-1-1-2\" data-name=\"decision card main title\">\n                                What would help you today?\n                            </h2>\n                        </div>\n                        <span class=\"flex h-10 w-10 items-center justify-center rounded-[10px] bg-[#315277] text-[#9DDFE3]\" data-kid=\"1-2-1-1-2-1-2\" data-name=\"route icon wrapper\">\n                            <i class=\"h-5 w-5\" data-kid=\"1-2-1-1-2-1-2-1\" data-lucide=\"route\" data-name=\"route icon\" style=\"width:20px;height:20px;color:#9DDFE3\">\n                            </i>\n                        </span>\n                    </div>\n                    <div class=\"mt-5 space-y-3\" data-kid=\"1-2-1-1-2-2\" data-name=\"decision options list\">\n                        <a class=\"group flex items-center gap-4 border-l-2 border-[var(--teal)] py-4 pl-3 no-underline\" data-kid=\"1-2-1-1-2-2-1\" data-name=\"check eligibility card link\" href=\"#eligibility\">\n                            <span class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-[9px] bg-[var(--teal)] text-white\" data-kid=\"1-2-1-1-2-2-1-1\" data-name=\"eligibility icon wrapper\">\n                                <i class=\"h-5 w-5\" data-kid=\"1-2-1-1-2-2-1-1-1\" data-lucide=\"check-square\" data-name=\"check square icon\" style=\"width:20px;height:20px;color:#fff\">\n                                </i>\n                            </span>\n                            <span class=\"min-w-0 flex-1\" data-kid=\"1-2-1-1-2-2-1-2\" data-name=\"eligibility card text group\">\n                                <strong class=\"block text-[15px] font-bold text-white\" data-kid=\"1-2-1-1-2-2-1-2-1\" data-name=\"eligibility card title\">\n                                    Check your eligibility\n                                </strong>\n                                <span class=\"mt-1 block text-[12px] leading-5 text-[#C6D1E1]\" data-kid=\"1-2-1-1-2-2-1-2-2\" data-name=\"eligibility card description\">\n                                    Enter O/A Level subjects and see which listed programmes fit.\n                                </span>\n                            </span>\n                            <i class=\"h-4 w-4\" data-kid=\"1-2-1-1-2-2-1-3\" data-lucide=\"arrow-up-right\" data-name=\"arrow up right icon\" style=\"width:16px;height:16px;color:#9DDFE3\">\n                            </i>\n                        </a>\n                        <a class=\"group flex items-center gap-4 border-l-2 border-transparent py-4 pl-3 no-underline hover:bg-white/5\" data-kid=\"1-2-1-1-2-2-2\" data-name=\"browse catalogue card link\" href=\"#programmes\">\n                            <span class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-[9px] bg-[#315277] text-[#B8DDE0]\" data-kid=\"1-2-1-1-2-2-2-1\" data-name=\"browse icon wrapper\">\n                                <i class=\"h-5 w-5\" data-kid=\"1-2-1-1-2-2-2-1-1\" data-lucide=\"layers-3\" data-name=\"layers icon\" style=\"width:20px;height:20px;color:#B8DDE0\">\n                                </i>\n                            </span>\n                            <span class=\"min-w-0 flex-1\" data-kid=\"1-2-1-1-2-2-2-2\" data-name=\"browse card text group\">\n                                <strong class=\"block text-[15px] font-bold text-white\" data-kid=\"1-2-1-1-2-2-2-2-1\" data-name=\"browse card title\">\n                                    Browse the catalogue\n                                </strong>\n                                <span class=\"mt-1 block text-[12px] leading-5 text-[#C6D1E1]\" data-kid=\"1-2-1-1-2-2-2-2-2\" data-name=\"browse card description\">\n                                    Compare degree type, academic unit, duration, and requirements.\n                                </span>\n                            </span>\n                            <i class=\"h-4 w-4\" data-kid=\"1-2-1-1-2-2-2-3\" data-lucide=\"arrow-up-right\" data-name=\"arrow up right icon\" style=\"width:16px;height:16px;color:#9DDFE3\">\n                            </i>\n                        </a>\n                    </div>\n                    <div class=\"record-rule mt-5 border-t border-white/10 pt-4\" data-kid=\"1-2-1-1-2-3\" data-name=\"applicant record summary container\">\n                        <div class=\"flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[.12em] text-[#9DDFE3]\" data-kid=\"1-2-1-1-2-3-1\" data-name=\"record summary header\">\n                            <i class=\"h-4 w-4\" data-kid=\"1-2-1-1-2-3-1-1\" data-lucide=\"file-check-2\" data-name=\"file check icon\" style=\"width:16px;height:16px;color:#9DDFE3\">\n                            </i>\n                            Applicant record\n                        </div>\n                        <div class=\"mt-3 grid grid-cols-3 gap-2 text-[11px] text-[#D4DCE8]\" data-kid=\"1-2-1-1-2-3-2\" data-name=\"record summary grid\">\n                            <span class=\"rounded-[6px] bg-white/5 px-2 py-2 text-center\" data-kid=\"1-2-1-1-2-3-2-1\" data-name=\"o level label\">\n                                O Level\n                            </span>\n                            <span class=\"rounded-[6px] bg-white/5 px-2 py-2 text-center\" data-kid=\"1-2-1-1-2-3-2-2\" data-name=\"a level label\">\n                                A Level\n                            </span>\n                            <span class=\"rounded-[6px] bg-white/5 px-2 py-2 text-center\" data-kid=\"1-2-1-1-2-3-2-3\" data-name=\"shortlist label\">\n                                Shortlist\n                            </span>\n                        </div>\n                    </div>\n                </aside>\n            </div>\n            <div class=\"border-t border-white/10 bg-[var(--navy-deep)]\" data-kid=\"1-2-1-2\" data-name=\"hero footer stats bar\">\n                <div class=\"hero-stats mx-auto grid max-w-[1180px] grid-cols-4 divide-x divide-white/10 px-8 py-6\" data-kid=\"1-2-1-2-1\" data-name=\"stats grid container\">\n                    <div class=\"pr-8\" data-kid=\"1-2-1-2-1-1\" data-name=\"stat unit 1\">\n                        <p class=\"text-[25px] font-bold tracking-[-.04em] text-white\" data-kid=\"1-2-1-2-1-1-1\" data-name=\"stat value 1\">\n                            435\n                        </p>\n                        <p class=\"mt-1 text-[12px] text-[#AAB8CC]\" data-kid=\"1-2-1-2-1-1-2\" data-name=\"stat label 1\">\n                            programmes in the catalogue\n                        </p>\n                    </div>\n                    <div class=\"px-8\" data-kid=\"1-2-1-2-1-2\" data-name=\"stat unit 2\">\n                        <p class=\"text-[25px] font-bold tracking-[-.04em] text-white\" data-kid=\"1-2-1-2-1-2-1\" data-name=\"stat value 2\">\n                            9\n                        </p>\n                        <p class=\"mt-1 text-[12px] text-[#AAB8CC]\" data-kid=\"1-2-1-2-1-2-2\" data-name=\"stat label 2\">\n                            faculties & schools\n                        </p>\n                    </div>\n                    <div class=\"px-8\" data-kid=\"1-2-1-2-1-3\" data-name=\"stat unit 3\">\n                        <p class=\"text-[25px] font-bold tracking-[-.04em] text-white\" data-kid=\"1-2-1-2-1-3-1\" data-name=\"stat value 3\">\n                            O/A\n                        </p>\n                        <p class=\"mt-1 text-[12px] text-[#AAB8CC]\" data-kid=\"1-2-1-2-1-3-2\" data-name=\"stat label 3\">\n                            level requirement matching\n                        </p>\n                    </div>\n                    <div class=\"pl-8\" data-kid=\"1-2-1-2-1-4\" data-name=\"stat unit 4\">\n                        <p class=\"text-[25px] font-bold tracking-[-.04em] text-white\" data-kid=\"1-2-1-2-1-4-1\" data-name=\"stat value 4\">\n                            1 place\n                        </p>\n                        <p class=\"mt-1 text-[12px] text-[#AAB8CC]\" data-kid=\"1-2-1-2-1-4-2\" data-name=\"stat label 4\">\n                            to start your shortlist\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <!-- How it works: a real flow, not equal cards -->\n        <section class=\"section-shell mx-auto max-w-[1100px] px-8 py-24\" data-kid=\"1-2-2\" data-name=\"how-it-works section\" id=\"eligibility\">\n            <div class=\"journey-grid grid grid-cols-[.7fr_1.3fr] gap-20\" data-kid=\"1-2-2-1\" data-name=\"how-it-works layout container\">\n                <div data-kid=\"1-2-2-1-1\" data-name=\"how-it-works intro content\">\n                    <p class=\"text-[12px] font-bold uppercase tracking-[.14em] text-[var(--teal-dark)]\" data-kid=\"1-2-2-1-1-1\" data-name=\"how-it-works label\">\n                        How it works\n                    </p>\n                    <h2 class=\"mt-4 text-[38px] font-bold leading-[1.08] tracking-[-.045em] text-[var(--ink)]\" data-kid=\"1-2-2-1-1-2\" data-name=\"how-it-works headline\">\n                        A clearer way to move from results to a shortlist.\n                    </h2>\n                    <p class=\"mt-5 text-[16px] leading-7 text-[var(--muted)]\" data-kid=\"1-2-2-1-1-3\" data-name=\"how-it-works description\">\n                        Start broad, then use your subjects and grades to narrow the decision. You stay in control of the final choice.\n                    </p>\n                    <a class=\"mt-7 inline-flex items-center gap-2 rounded-[8px] bg-[var(--navy)] px-4 py-3 text-[13px] font-bold text-white no-underline\" data-kid=\"1-2-2-1-1-4\" data-name=\"how-it-works check eligibility link\" href=\"#\">\n                        Check eligibility\n                        <i class=\"h-4 w-4\" data-kid=\"1-2-2-1-1-4-1\" data-lucide=\"arrow-right\" data-name=\"arrow right icon\" style=\"width:16px;height:16px;color:#fff\">\n                        </i>\n                    </a>\n                </div>\n                <div class=\"relative pt-1\" data-kid=\"1-2-2-1-2\" data-name=\"how-it-works steps container\">\n                    <div class=\"absolute bottom-8 left-[25px] top-8 w-px bg-[var(--line)]\" data-kid=\"1-2-2-1-2-1\" data-name=\"steps vertical connecting line\">\n                    </div>\n                    <div class=\"space-y-9\" data-kid=\"1-2-2-1-2-2\" data-name=\"steps list\">\n                        <div class=\"relative flex gap-6\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"step 1 container\">\n                            <span class=\"z-10 flex h-[52px] w-[52px] shrink-0 items-center justify-center rounded-full border-[6px] border-white bg-[var(--navy)] text-[14px] font-bold text-white shadow-sm\" data-kid=\"1-2-2-1-2-2-1-1\" data-name=\"step 1 number\">\n                                01\n                            </span>\n                            <div class=\"pt-1\" data-kid=\"1-2-2-1-2-2-1-2\" data-name=\"step 1 text content\">\n                                <h3 class=\"text-[18px] font-bold text-[var(--ink)]\" data-kid=\"1-2-2-1-2-2-1-2-1\" data-name=\"step 1 title\">\n                                    Choose a university\n                                </h3>\n                                <p class=\"mt-1 max-w-[520px] text-[14px] leading-6 text-[var(--muted)]\" data-kid=\"1-2-2-1-2-2-1-2-2\" data-name=\"step 1 description\">\n                                    Keep the catalogue, faculties, and guidance scoped to the university you are exploring.\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"relative flex gap-6\" data-kid=\"1-2-2-1-2-2-2\" data-name=\"step 2 container\">\n                            <span class=\"z-10 flex h-[52px] w-[52px] shrink-0 items-center justify-center rounded-full border-[6px] border-white bg-[#E6F7F8] text-[14px] font-bold text-[var(--teal-dark)] shadow-sm\" data-kid=\"1-2-2-1-2-2-2-1\" data-name=\"step 2 number\">\n                                02\n                            </span>\n                            <div class=\"pt-1\" data-kid=\"1-2-2-1-2-2-2-2\" data-name=\"step 2 text content\">\n                                <h3 class=\"text-[18px] font-bold text-[var(--ink)]\" data-kid=\"1-2-2-1-2-2-2-2-1\" data-name=\"step 2 title\">\n                                    Search or browse programmes\n                                </h3>\n                                <p class=\"mt-1 max-w-[520px] text-[14px] leading-6 text-[var(--muted)]\" data-kid=\"1-2-2-1-2-2-2-2-2\" data-name=\"step 2 description\">\n                                    Compare degree type, academic unit, duration, and the requirements recorded for each programme.\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"relative flex gap-6\" data-kid=\"1-2-2-1-2-2-3\" data-name=\"step 3 container\">\n                            <span class=\"z-10 flex h-[52px] w-[52px] shrink-0 items-center justify-center rounded-full border-[6px] border-white bg-[#E6F7F8] text-[14px] font-bold text-[var(--teal-dark)] shadow-sm\" data-kid=\"1-2-2-1-2-2-3-1\" data-name=\"step 3 number\">\n                                03\n                            </span>\n                            <div class=\"pt-1\" data-kid=\"1-2-2-1-2-2-3-2\" data-name=\"step 3 text content\">\n                                <h3 class=\"text-[18px] font-bold text-[var(--ink)]\" data-kid=\"1-2-2-1-2-2-3-2-1\" data-name=\"step 3 title\">\n                                    Enter O/A Level results\n                                </h3>\n                                <p class=\"mt-1 max-w-[520px] text-[14px] leading-6 text-[var(--muted)]\" data-kid=\"1-2-2-1-2-2-3-2-2\" data-name=\"step 3 description\">\n                                    Add the subjects and grades used by the listed eligibility rules. Missing requirements stay visible.\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"relative flex gap-6\" data-kid=\"1-2-2-1-2-2-4\" data-name=\"step 4 container\">\n                            <span class=\"z-10 flex h-[52px] w-[52px] shrink-0 items-center justify-center rounded-full border-[6px] border-white bg-[#FFF3D8] text-[14px] font-bold text-[#A66A00] shadow-sm\" data-kid=\"1-2-2-1-2-2-4-1\" data-name=\"step 4 number\">\n                                04\n                            </span>\n                            <div class=\"pt-1\" data-kid=\"1-2-2-1-2-2-4-2\" data-name=\"step 4 text content\">\n                                <h3 class=\"text-[18px] font-bold text-[var(--ink)]\" data-kid=\"1-2-2-1-2-2-4-2-1\" data-name=\"step 4 title\">\n                                    Review and decide\n                                </h3>\n                                <p class=\"mt-1 max-w-[520px] text-[14px] leading-6 text-[var(--muted)]\" data-kid=\"1-2-2-1-2-2-4-2-2\" data-name=\"step 4 description\">\n                                    Use the result as a guide to open programme details, compare options, or confirm with admissions.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <!-- Featured programmes: structured comparable rows -->\n        <section class=\"border-y border-[var(--line)] bg-[var(--mist)] py-24\" data-kid=\"1-2-3\" data-name=\"featured programmes section\" id=\"programmes\">\n            <div class=\"section-shell mx-auto max-w-[1100px] px-8\" data-kid=\"1-2-3-1\" data-name=\"featured programmes container\">\n                <div class=\"featured-header flex items-end justify-between\" data-kid=\"1-2-3-1-1\" data-name=\"featured programmes header\">\n                    <div data-kid=\"1-2-3-1-1-1\" data-name=\"featured programmes header intro\">\n                        <p class=\"text-[12px] font-bold uppercase tracking-[.14em] text-[var(--teal-dark)]\" data-kid=\"1-2-3-1-1-1-1\" data-name=\"featured programmes label\">\n                            Explore the catalogue\n                        </p>\n                        <h2 class=\"mt-3 text-[38px] font-bold tracking-[-.045em] text-[var(--ink)]\" data-kid=\"1-2-3-1-1-1-2\" data-name=\"featured programmes title\">\n                            Featured programmes\n                        </h2>\n                        <p class=\"mt-3 text-[15px] text-[var(--muted)]\" data-kid=\"1-2-3-1-1-1-3\" data-name=\"featured programmes description\">\n                            A quick view of what is currently listed for The University of Bamenda.\n                        </p>\n                    </div>\n                    <a class=\"flex items-center gap-2 rounded-[8px] border border-[var(--line)] bg-white px-4 py-3 text-[13px] font-bold text-[var(--navy)] no-underline shadow-sm\" data-kid=\"1-2-3-1-1-2\" data-name=\"view all link\" href=\"#\">\n                        View all 435\n                        <i class=\"h-4 w-4\" data-kid=\"1-2-3-1-1-2-1\" data-lucide=\"arrow-right\" data-name=\"arrow right icon\" style=\"width:16px;height:16px;color:var(--navy)\">\n                        </i>\n                    </a>\n                </div>\n                <div class=\"mt-9 overflow-hidden rounded-[14px] border border-[var(--line)] bg-white shadow-[0_8px_24px_rgba(20,33,61,.05)]\" data-kid=\"1-2-3-1-2\" data-name=\"programmes table container\">\n                    <div class=\"programme-header grid grid-cols-[1.5fr_.75fr_.9fr_.65fr_auto] gap-5 border-b border-[var(--line)] bg-[#FAFBFC] px-6 py-3 text-[11px] font-bold uppercase tracking-[.1em] text-slate-500\" data-kid=\"1-2-3-1-2-1\" data-name=\"programmes table header row\">\n                        <span data-kid=\"1-2-3-1-2-1-1\" data-name=\"programme label\">\n                            Programme\n                        </span>\n                        <span data-kid=\"1-2-3-1-2-1-2\" data-name=\"degree label\">\n                            Degree\n                        </span>\n                        <span data-kid=\"1-2-3-1-2-1-3\" data-name=\"academic unit label\">\n                            Academic unit\n                        </span>\n                        <span data-kid=\"1-2-3-1-2-1-4\" data-name=\"duration label\">\n                            Duration\n                        </span>\n                        <span data-kid=\"1-2-3-1-2-1-5\" data-name=\"empty action label\">\n                        </span>\n                    </div>\n                    <div class=\"divide-y divide-[var(--line)]\" data-kid=\"1-2-3-1-2-2\" data-name=\"programmes table body\">\n                        <a class=\"programme-row grid grid-cols-[1.5fr_.75fr_.9fr_.65fr_auto] items-center gap-5 px-6 py-5 no-underline hover:bg-[#F9FCFC]\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"row 1 link\" href=\"#\">\n                            <div data-kid=\"1-2-3-1-2-2-1-1\" data-name=\"row 1 title cell\">\n                                <div class=\"flex items-center gap-3\" data-kid=\"1-2-3-1-2-2-1-1-1\" data-name=\"row 1 title group\">\n                                    <h3 class=\"text-[16px] font-bold text-[var(--ink)]\" data-kid=\"1-2-3-1-2-2-1-1-1-1\" data-name=\"row 1 title text\">\n                                        Agricultural Engeenering\n                                    </h3>\n                                    <span class=\"rounded-[5px] bg-[#EAF7F8] px-2 py-1 font-mono text-[10px] font-bold text-[var(