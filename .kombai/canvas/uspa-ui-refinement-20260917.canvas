" data-kid=\"1-2-3-1-2-1-1-1\" data-name=\"table header title container\">\n                                <span class=\"flex h-8 w-8 items-center justify-center rounded-lg bg-[#DCEFED] text-[#0FA3B1]\" data-kid=\"1-2-3-1-2-1-1-1-1\" data-name=\"filter icon container\">\n                                    <i class=\"h-4 w-4\" data-kid=\"1-2-3-1-2-1-1-1-1-1\" data-lucide=\"list-filter\" data-name=\"list filter icon\">\n                                    </i>\n                                </span>\n                                <span class=\"text-[14px] font-bold text-[#17233D]\" data-kid=\"1-2-3-1-2-1-1-1-2\" data-name=\"table header title\">\n                                    Popular in the current catalogue\n                                </span>\n                            </div>\n                            <span class=\"text-[12px] font-medium text-[#667085]\" data-kid=\"1-2-3-1-2-1-1-2\" data-name=\"table header count text\">\n                                Showing 4 of 435\n                            </span>\n                        </div>\n                        <div class=\"divide-y divide-[#E3E5E1]\" data-kid=\"1-2-3-1-2-1-2\" data-name=\"table rows container\">\n                            <div class=\"grid grid-cols-[1fr_auto] gap-5 px-5 py-5\" data-kid=\"1-2-3-1-2-1-2-1\" data-name=\"table row 1\">\n                                <div class=\"min-w-0\" data-kid=\"1-2-3-1-2-1-2-1-1\" data-name=\"programme info column\">\n                                    <div class=\"flex flex-wrap items-center gap-2\" data-kid=\"1-2-3-1-2-1-2-1-1-1\" data-name=\"tags container\">\n                                        <span class=\"rounded-md bg-[#E8EEF0] px-2 py-1 text-[11px] font-bold text-[#1B2A4A]\" data-kid=\"1-2-3-1-2-1-2-1-1-1-1\" data-name=\"degree type tag\">\n                                            BSC\n                                        </span>\n                                        <span class=\"text-[11px] font-medium text-[#7B8