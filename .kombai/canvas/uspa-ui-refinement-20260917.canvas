        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap');\n  .uspa-page { font-family: 'Geist', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }\n  .record-lines { background-image: linear-gradient(to bottom, rgba(27,42,74,.08) 1px, transparent 1px); background-size: 100% 32px; }\n  .paper-rule { background-image: linear-gradient(to right, rgba(27,42,74,.12) 1px, transparent 1px); background-size: 28px 100%; }\n</style>\n<div class=\"uspa-page min-h-screen bg-[#f7f5f0] text-[#172033]\" data-kid=\"1\">\n    <header class=\"sticky top-0 z-50 border-b border-[#dfe2e5] bg-white/95 backdrop-blur-sm\" data-kid=\"1-1\">\n        <div class=\"mx-auto flex h-[72px] max-w-[1200px] items-center justify-between gap-6 px-6 lg:px-8\" data-kid=\"1-1-1\">\n            <a class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-1-1-1\" href=\"#top\">\n                <span class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-[10px] bg-[#1B2A4A] text-white\" data-kid=\"1-1-1-1-1\">\n                    <i class=\"h-5 w-5\" data-kid=\"1-1-1-1-1-1\" data-lucide=\"graduation-cap\">\n                    </i>\n                </span>\n                <span class=\"hidden min-w-0 items-baseline gap-2 sm:flex\" data-kid=\"1-1-1-1-2\">\n                    <strong class=\"text-[18px] font-bold tracking-[-0.03em] text-[#172033]\" data-kid=\"1-1-1-1-2-1\">\n                        USPA\n                    </strong>\n                    <span class=\"text-[12px] text-[#6c7480]\" data-kid=\"1-1-1-1-2-2\">\n                        Smart Advisor\n                    </span>\n                </span>\n                <button class=\"hidden min-w-0 items-center gap-1.5 rounded-md border border-[#dfe2e5] bg-[#fbfbfa] px-2.5 py-1.5 text-[12px] font-semibold text-[#46505d] hover:border-[#0FA3B1] sm:flex\" data-kid=\"1-1-1-1-3\">\n                    <i class=\"h-3.5 w-3.5\" data-kid=\"1-1-1-1-3-1\" data-lucide=\"building-2\">\n                    </i>\n                    <span class=\"truncate\" data-kid=\"1-1-1-1-3-2\">\n                        UBa\n                    </span>\n                    <i class=\"h-3 w-3\" data-kid=\"1-1-1-1-3-3\" data-lucide=\"chevron-down\">\n                    </i>\n                </button>\n            </a>\n            <nav class=\"hidden items-center gap-1 md:flex\" data-kid=\"1-1-1-2\">\n                <a class=\"flex items-center gap-2 rounded-md px-3 py-2 text-[13px] font-medium text-[#46505d] hover:bg-[#f2f4f5] hover:text-[#172033]\" data-kid=\"1-1-1-2-1\" href=\"#programmes\">\n                    <i class=\"h-4 w-4\" data-kid=\"1-1-1-2-1-1\" data-lucide=\"book-open\">\n                    </i>\n                    Programmes\n                </a>\n                <a class=\"flex items-center gap-2 rounded-md px-3 py-2 text-[13px] font-medium text-[#46505d] hover:bg-[#f2f4f5] hover:text-[#172033]\" data-kid=\"1-1-1-2-2\" href=\"#faculties\">\n                    <i class=\"h-4 w-4\" data-kid=\"1-1-1-2-2-1\" data-lucide=\"building-2\">\n                    </i>\n                    Faculties\n                </a>\n                <a class=\"flex items-center gap-2 rounded-md px-3 py-2 text-[13px] font-medium text-[#46505d] hover:bg-[#f2f4f5] hover:text-[#172033]\" data-kid=\"1-1-1-2-3\" href=\"#eligibility\">\n                    <i class=\"h-4 w-4\" data-kid=\"1-1-1-2-3-1\" data-lucide=\"graduation-cap\">\n                    </i>\n                    Eligibility\n                </a>\n                <a class=\"flex items-center gap-2 rounded-md px-3 py-2 text-[13px] font-medium text-[#46505d] hover:bg-[#f2f4f5] hover:text-[#172033]\" data-kid=\"1-1-1-2-4\" href=\"#advisor\">\n                    <i class=\"h-4 w-4\" data-kid=\"1-1-1-2-4-1\" data-lucide=\"bot\">\n                    </i>\n                    AI Advisor\n                </a>\n            </nav>\n            <div class=\"flex shrink-0 items-center gap-2\" data-kid=\"1-1-1-3\">\n                <button aria-label=\"Search\" class=\"hidden h-10 w-10 items-center justify-center rounded-md text-[#172033] hover:bg-[#f2f4f5] sm:flex\" data-kid=\"1-1-1-3-1\">\n                    <i class=\"h-[19px] w-[19px]\" data-kid=\"1-1-1-3-1-1\" data-lucide=\"search\">\n                    </i>\n                </button>\n                <button aria-label=\"Toggle theme\" class=\"hidden h-10 w-10 items-center justify-center rounded-md text-[#172033] hover:bg-[#f2f4f5] sm:flex\" data-kid=\"1-1-1-3-2\">\n                    <i class=\"h-[18px] w-[18px]\" data-kid=\"1-1-1-3-2-1\" data-lucide=\"moon\">\n                    </i>\n                </button>\n                <a class=\"hidden px-3 py-2 text-[13px] font-medium text-[#172033] sm:block\" data-kid=\"1-1-1-3-3\" href=\"#login\">\n                    Log in\n                </a>\n                <a class=\"hidden rounded-md bg-[#1B2A4A] px-4 py-2.5 text-[13px] font-semibold text-white shadow-sm hover:bg-[#0F1B33] sm:block\" data-kid=\"1-1-1-3-4\" href=\"#signup\">\n                    Sign up\n                </a>\n                <button aria-label=\"Open menu\" class=\"flex h-10 w-10 items-center justify-center rounded-md text-[#172033] hover:bg-[#f2f4f5] md:hidden\" data-kid=\"1-1-1-3-5\">\n                    <i class=\"h-5 w-5\" data-kid=\"1-1-1-3-5-1\" data-lucide=\"menu\">\n                    </i>\n                </button>\n            </div>\n        </div>\n    </header>\n    <main data-kid=\"1-2\" id=\"top\">\n        <section class=\"border-b border-[#dfe2e5] bg-[#fbfaf7]\" data-kid=\"1-2-1\">\n            <div class=\"mx-auto max-w-[1200px] px-6 pb-16 pt-12 lg:px-8 lg:pb-20 lg:pt-16\" data-kid=\"1-2-1-1\">\n                <div class=\"grid items-start gap-12 lg:grid-cols-[1.08fr_.92fr] lg:gap-16\" data-kid=\"1-2-1-1-1\">\n                    <div class=\"min-w-0\" data-kid=\"1-2-1-1-1-1\">\n                        <div class=\"mb-6 flex flex-wrap items-center gap-3 text-[11px] font-semibold uppercase tracking-[0.17em] text-[#6c7480]\" data-kid=\"1-2-1-1-1-1-1\">\n                            <span class=\"inline-flex items-center gap-2 text-[#0C8793]\" data-kid=\"1-2-1-1-1-1-1-1\">\n                                <span class=\"h-2 w-2 rounded-full bg-[#0FA3B1]\" data-kid=\"1-2-1-1-1-1-1-1-1\">\n                                </span>\n                                Admissions desk\n                            </span>\n                            <span class=\"text-[#c0c5ca]\" data-kid=\"1-2-1-1-1-1-1-2\">\n                                /\n                            </span>\n                            <span data-kid=\"1-2-1-1-1-1-1-3\">\n                                2026/27 catalogue\n                            </span>\n                        </div>\n                        <button class=\"mb-6 inline-flex max-w-full items-center gap-2 rounded-full border border-[#cfd5d8] bg-white px-3.5 py-2 text-[13px] font-semibold text-[#46505d] shadow-xs hover:border-[#0FA3B1]\" data-kid=\"1-2-1-1-1-1-2\">\n                            <i class=\"h-4 w-4 text-[#0FA3B1]\" data-kid=\"1-2-1-1-1-1-2-1\" data-lucide=\"building-2\">\n                            </i>\n                            <span class=\"truncate\" data-kid=\"1-2-1-1-1-1-2-2\">\n                                The University of Bamenda\n                            </span>\n                            <i class=\"h-3.5 w-3.5\" data-kid=\"1-2-1-1-1-1-2-3\" data-lucide=\"chevron-down\">\n                            </i>\n                        </button>\n                        <h1 class=\"max-w-[650px] text-[46px] font-semibold leading-[1.05] tracking-[-0.055em] text-[#1B2A4A] sm:text-[56px]\" data-kid=\"1-2-1-1-1-1-3\">\n                            Find Your Perfect\n                            <br data-kid=\"1-2-1-1-1-1-3-1\"/>\n                            <span class=\"text-[#0FA3B1]\" data-kid=\"1-2-1-1-1-1-3-2\">\n                                Academic Programme\n                            </span>\n                        </h1>\n                        <p class=\"mt-6 max-w-[580px] text-[17px] leading-8 text-[#4e5865]\" data-kid=\"1-2-1-1-1-1-4\">\n                            Search the current catalogue, check listed requirements against your subjects, and make a confident next step — with the final decision always confirmed by the institution.\n                        </p>\n                        <form class=\"mt-8 max-w-[650px] rounded-[12px] border border-[#cfd5d8] bg-white p-2 shadow-sm\" data-kid=\"1-2-1-1-1-1-5\">\n                            <div class=\"flex items-center gap-3\" data-kid=\"1-2-1-1-1-1-5-1\">\n                                <i class=\"ml-3 h-5 w-5 shrink-0 text-[#7d8792]\" data-kid=\"1-2-1-1-1-1-5-1-1\" data-lucide=\"search\">\n                                </i>\n                                <input aria-label=\"Search programmes\" class=\"min-w-0 flex-1 bg-transparent py-3 text-[14px] text-[#172033] outline-none placeholder:text-[#8b949e]\" data-kid=\"1-2-1-1-1-1-5-1-2\" placeholder=\"Search by programme, subject, career, or code\"/>\n                                <button class=\"inline-flex shrink-0 items-center gap-2 rounded-[8px] bg-[#0FA3B1] px-4 py-3 text-[13px] font-semibold text-white shadow-sm hover:bg-[#0C8793]\" data-kid=\"1-2-1-1-1-1-5-1-3\" type=\"button\">\n                                    Find programmes\n                                    <i class=\"h-4 w-4\" data-kid=\"1-2-1-1-1-1-5-1-3-1\" data-lucide=\"arrow-up-right\">\n                                    </i>\n                                </button>\n                            </div>\n                        </form>\n                        <div class=\"mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-[12px] text-[#6c7480]\" data-kid=\"1-2-1-1-1-1-6\">\n                            <span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-2-1-1-1-1-6-1\">\n                                <i class=\"h-3.5 w-3.5 text-[#0FA3B1]\" data-kid=\"1-2-1-1-1-1-6-1-1\" data-lucide=\"database\">\n                                </i>\n                                435 programmes in the current catalogue\n                            </span>\n                            <span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-2-1-1-1-1-6-2\">\n                                <i class=\"h-3.5 w-3.5 text-[#0FA3B1]\" data-kid=\"1-2-1-1-1-1-6-2-1\" data-lucide=\"shield-check\">\n                                </i>\n                                Listed requirements, clearly labelled\n                            </span>\n                        </div>\n                        <div class=\"mt-9 flex flex-wrap items-center gap-3 border-t border-[#dfe2e5] pt-5\" data-kid=\"1-2-1-1-1-1-7\">\n                            <a class=\"inline-flex items-center gap-2 rounded-md bg-[#1B2A4A] px-4 py-2.5 text-[13px] font-semibold text-white hover:bg-[#0F1B33]\" data-kid=\"1-2-1-1-1-1-7-1\" href=\"#programmes\">\n                                Browse programmes\n                                <i class=\"h-4 w-4\" data-kid=\"1-2-1-1-1-1-7-1-1\" data-lucide=\"arrow-right\">\n                                </i>\n                            </a>\n                            <a class=\"inline-flex items-center gap-2 rounded-md border border-[#cfd5d8] bg-white px-4 py-2.5 text-[13px] font-semibold text-[#1B2A4A] hover:border-[#0FA3B1]\" data-kid=\"1-2-1-1-1-1-7-2\" href=\"#eligibility\">\n                                Check eligibility\n                            </a>\n                            <a class=\"inline-flex items-center gap-2 px-2 py-2.5 text-[13px] font-semibold text-[#0C8793]\" data-kid=\"1-2-1-1-1-1-7-3\" href=\"#advisor\">\n                                Ask the AI Advisor\n                                <i class=\"h-3.5 w-3.5\" data-kid=\"1-2-1-1-1-1-7-3-1\" data-lucide=\"arrow-up-right\">\n                                </i>\n                            </a>\n                        </div>\n                    </div>\n                    <div class=\"relative min-w-0 lg:pt-8\" data-kid=\"1-2-1-1-1-2\">\n                        <div class=\"absolute -left-3 top-12 hidden h-[calc(100%-40px)] w-px bg-[#0FA3B1] lg:block\" data-kid=\"1-2-1-1-1-2-1\">\n                        </div>\n                        <div class=\"overflow-hidden rounded-[16px] bg-[#1B2A4A] text-white shadow-[0_18px_45px_rgba(27,42,74,.18)]\" data-kid=\"1-2-1-1-1-2-2\">\n                            <div class=\"flex items-start justify-between border-b border-white/15 px-6 py-5 sm:px-7\" data-kid=\"1-2-1-1-1-2-2-1\">\n                                <div data-kid=\"1-2-1-1-1-2-2-1-1\">\n                                    <p class=\"text-[10px] font-semibold uppercase tracking-[0.2em] text-[#7edbe2]\" data-kid=\"1-2-1-1-1-2-2-1-1-1\">\n                                        Requirements record\n                                    </p>\n                                    <h2 class=\"mt-2 text-[22px] font-semibold tracking-[-0.03em]\" data-kid=\"1-2-1-1-1-2-2-1-1-2\">\n                                        BSc. Accounting\n                                    </h2>\n                                </div>\n                                <span class=\"rounded-full border border-[#7edbe2]/40 bg-[#0FA3B1]/20 px-3 py-1.5 font-mono text-[11px] font-semibold text-[#a6edf0]\" data-kid=\"1-2-1-1-1-2-2-1-2\">\n                                    ACC\n                                </span>\n                            </div>\n                            <div class=\"record-lines px-6 py-2 sm:px-7\" data-kid=\"1-2-1-1-1-2-2-2\">\n                                <div class=\"grid grid-cols-[1fr_auto] gap-4 border-b border-white/10 py-4\" data-kid=\"1-2-1-1-1-2-2-2-1\">\n                                    <div data-kid=\"1-2-1-1-1-2-2-2-1-1\">\n                                        <p class=\"text-[11px] font-semibold uppercase tracking-[0.13em] text-white/50\" data-kid=\"1-2-1-1-1-2-2-2-1-1-1\">\n                                            Level\n                                        </p>\n                                        <p class=\"mt-1 text-[14px] font-medium text-white\" data-kid=\"1-2-1-1-1-2-2-2-1-1-2\">\n                                            Undergraduate\n                                        </p>\n                                    </div>\n                                    <span class=\"self-end text-[11px] text-white/50\" data-kid=\"1-2-1-1-1-2-2-2-1-2\" data-name=\"source note for level\">\n                                        listed\n                                    </span>\n                                </div>\n                                <div class=\"grid grid-cols-[1fr_auto] gap-4 border-b border-white/10 py-4\" data-kid=\"1-2-1-1-1-2-2-2-2\">\n                                    <div data-kid=\"1-2-1-1-1-2-2-2-2-1\">\n                                        <p class=\"text-[11px] font-semibold uppercase tracking-[0.13em] text-white/50\" data-kid=\"1-2-1-1-1-2-2-2-2-1-1\">\n                                            Duration\n                                        </p>\n                                        <p class=\"mt-1 text-[14px] font-medium text-white\" data-kid=\"1-2-1-1-1-2-2-2-2-1-2\">\n                                            3 years\n                                        </p>\n                                    </div>\n                                    <span class=\"self-end text-[11px] text-white/50\" data-kid=\"1-2-1-1-1-2-2-2-2-2\" data-name=\"source note for duration\">\n                                        catalogue\n                                    </span>\n                                </div>\n                                <div class=\"grid grid-cols-[1fr_auto] gap-4 border-b border-white/10 py-4\" data-kid=\"1-2-1-1-1-2-2-2-3\">\n                                    <div data-kid=\"1-2-1-1-1-2-2-2-3-1\">\n                                        <p class=\"text-[11px] font-semibold uppercase tracking-[0.13em] text-white/50\" data-kid=\"1-2-1-1-1-2-2-2-3-1-1\">\n                                            Requirements\n                                        </p>\n                                        <p class=\"mt-1 text-[14px] font-medium text-white\" data-kid=\"1-2-1-1-1-2-2-2-3-1-2\">\n                                            View listed subjects and grades\n                                        </p>\n                                    </div>\n                                    <i class=\"mt-1 h-4 w-4 text-[#7edbe2]\" data-kid=\"1-2-1-1-1-2-2-2-3-2\" data-lucide=\"arrow-up-right\">\n                                    </i>\n                                </div>\n                                <div class=\"grid grid-cols-[1fr_auto] gap-4 py-4\" data-kid=\"1-2-1-1-1-2-2-2-4\">\n                                    <div data-kid=\"1-2-1-1-1-2-2-2-4-1\">\n                                        <p class=\"text-[11px] font-semibold uppercase tracking-[0.13em] text-white/50\" data-kid=\"1-2-1-1-1-2-2-2-4-1-1\">\n                                            Tuition\n                                        </p>\n                                        <p class=\"mt-1 text-[14px] font-medium text-white\" data-kid=\"1-2-1-1-1-2-2-2-4-1-2\">\n                                            See the current programme record\n                                        </p>\n                                    </div>\n                                    <span class=\"self-end text-[11px] text-[#f5c873]\" data-kid=\"1-2-1-1-1-2-2-2-4-2\" data-name=\"source note for tuition\">\n                                        verify\n                                    </span>\n                                </div>\n                            </div>\n                            <div class=\"border-t border-white/15 bg-[#14233f] px-6 py-5 sm:px-7\" data-kid=\"1-2-1-1-1-2-2-3\">\n                                <div class=\"flex gap-3\" data-kid=\"1-2-1-1-1-2-2-3-1\">\n                                    <i class=\"mt-0.5 h-4 w-4 shrink-0 text-[#f5c873]\" data-kid=\"1-2-1-1-1-2-2-3-1-1\" data-lucide=\"info\">\n                                    </i>\n                                    <p class=\"text-[12px] leading-5 text-white/70\" data-kid=\"1-2-1-1-1-2-2-3-1-2\">\n                                        <strong class=\"font-semibold text-white\" data-kid=\"1-2-1-1-1-2-2-3-1-2-1\">\n                                            Guidance boundary.\n                                        </strong>\n                                        USPA compares the information listed in the catalogue. Confirm final requirements, fees, and intake details with the institution.\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"mt-4 flex items-center justify-between gap-4 px-1 text-[11px] uppercase tracking-[0.14em] text-[#7d8792]\" data-kid=\"1-2-1-1-1-2-3\">\n                            <span data-kid=\"1-2-1-1-1-2-3-1\">\n                                One record at a time\n                            </span>\n                            <span class=\"h-px flex-1 bg-[#d6dadd]\" data-kid=\"1-2-1-1-1-2-3-2\">\n                            </span>\n                            <span data-kid=\"1-2-1-1-1-2-3-3\">\n                                Evidence before choice\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"border-b border-[#dfe2e5] bg-white\" data-kid=\"1-2-2\" id=\"eligibility\">\n            <div class=\"mx-auto max-w-[1200px] px-6 py-16 lg:px-8 lg:py-20\" data-kid=\"1-2-2-1\">\n                <div class=\"flex flex-col justify-between gap-5 border-b border-[#dfe2e5] pb-7 sm:flex-row sm:items-end\" data-kid=\"1-2-2-1-1\">\n                    <div data-kid=\"1-2-2-1-1-1\">\n                        <p class=\"text-[11px] font-semibold uppercase tracking-[0.18em] text-[#0C8793]\" data-kid=\"1-2-2-1-1-1-1\">\n                            How it works\n                        </p>\n                        <h2 class=\"mt-3 text-[32px] font-semibold leading-tight tracking-[-0.045em] text-[#1B2A4A] sm:text-[38px]\" data-kid=\"1-2-2-1-1-1-2\">\n                            Start with the question\n                            <br class=\"hidden sm:block\" data-kid=\"1-2-2-1-1-1-2-1\"/>\n                            you need answered.\n                        </h2>\n                    </div>\n                    <p class=\"max-w-[360px] text-[14px] leading-6 text-[#5f6874]\" data-kid=\"1-2-2-1-1-2\">\n                        A clear route from a search term or result slip to a shortlist you can verify.\n                    </p>\n                </div>\n                <div class=\"mt-10 grid gap-0 md:grid-cols-4\" data-kid=\"1-2-2-1-2\">\n                    <div class=\"relative border-l-2 border-[#0FA3B1] px-5 pb-6 md:pb-0\" data-kid=\"1-2-2-1-2-1\">\n                        <div class=\"font-mono text-[12px] font-semibold text-[#0FA3B1]\" data-kid=\"1-2-2-1-2-1-1\">\n                            01\n                        </div>\n                        <h3 class=\"mt-3 text-[16px] font-semibold text-[#1B2A4A]\" data-kid=\"1-2-2-1-2-1-2\">\n                            Search the catalogue\n                        </h3>\n                        <p class=\"mt-2 text-[13px] leading-6 text-[#626c78]\" data-kid=\"1-2-2-1-2-1-3\">\n                            Use a programme name, subject, career, or code to find records in your selected university.\n                        </p>\n                    </div>\n                    <div class=\"relative border-l border-[#cfd5d8] px-5 pb-6 md:pb-0\" data-kid=\"1-2-2-1-2-2\">\n                        <div class=\"font-mono text-[12px] font-semibold text-[#7d8792]\" data-kid=\"1-2-2-1-2-2-1\">\n                            02\n                        </div>\n                        <h3 class=\"mt-3 text-[16px] font-semibold text-[#1B2A4A]\" data-kid=\"1-2-2-1-2-2-2\">\n                            Check eligibility\n                        </h3>\n                        <p class=\"mt-2 text-[13px] leading-6 text-[#626c78]\" data-kid=\"1-2-2-1-2-2-3\">\n                            Enter the required O/A Level results or the previous degree information for your path.\n                        </p>\n                    </div>\n                    <div class=\"relative border-l border-[#cfd5d8] px-5 pb-6 md:pb-0\" data-kid=\"1-2-2-1-2-3\">\n                        <div class=\"font-mono text-[12px] font-semibold text-[#7d8792]\" data-kid=\"1-2-2-1-2-3-1\">\n                            03\n                        </div>\n                        <h3 class=\"mt-3 text-[16px] font-semibold text-[#1B2A4A]\" data-kid=\"1-2-2-1-2-3-2\">\n                            Review the evidence\n                        </h3>\n                        <p class=\"mt-2 text-[13px] leading-6 text-[#626c78]\" data-kid=\"1-2-2-1-2-3-3\">\n                            See which listed requirements are met, missing, or need confirmation — without a made-up score.\n                        </p>\n                    </div>\n                    <div class=\"relative border-l border-[#cfd5d8] px-5\" data-kid=\"1-2-2-1-2-4\">\n                        <div class=\"font-mono text-[12px] font-semibold text-[#7d8792]\" data-kid=\"1-2-2-1-2-4-1\">\n                            04\n                        </div>\n                        <h3 class=\"mt-3 text-[16px] font-semibold text-[#1B2A4A]\" data-kid=\"1-2-2-1-2-4-2\">\n                            Choose a next step\n                        </h3>\n                        <p class=\"mt-2 text-[13px] leading-6 text-[#626c78]\" data-kid=\"1-2-2-1-2-4-3\">\n                            Open the programme record, compare options, or verify the final details with admissions.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"border-b border-[#dfe2e5] bg-[#f7f5f0]\" data-kid=\"1-2-3\" id=\"programmes\">\n            <div class=\"mx-auto max-w-[1200px] px-6 py-16 lg:px-8 lg:py-20\" data-kid=\"1-2-3-1\">\n                <div class=\"flex flex-col justify-between gap-5 sm:flex-row sm:items-end\" data-kid=\"1-2-3-1-1\">\n                    <div data-kid=\"1-2-3-1-1-1\">\n                        <p class=\"text-[11px] font-semibold uppercase tracking-[0.18em] text-[#0C8793]\" data-kid=\"1-2-3-1-1-1-1\">\n                            Featured programmes\n                        </p>\n                        <h2 class=\"mt-3 text-[32px] font-semibold tracking-[-0.045em] text-[#1B2A4A] sm:text-[38px]\" data-kid=\"1-2-3-1-1-1-2\">\n                            Programme records, not promises.\n                        </h2>\n                        <p class=\"mt-3 max-w-[560px] text-[14px] leading-6 text-[#626c78]\" data-kid=\"1-2-3-1-1-1-3\">\n                            A preview of how the catalogue can surface the facts students need before they decide.\n                        </p>\n                    </div>\n                    <a class=\"inline-flex items-center gap-2 text-[13px] font-semibold text-[#0C8793]\" data-kid=\"1-2-3-1-1-2\" href=\"#all-programmes\">\n                        View all 435 records\n                        <i class=\"h-4 w-4\" data-kid=\"1-2-3-1-1-2-1\" data-lucide=\"arrow-up-right\">\n                        </i>\n                    </a>\n                </div>\n                <div class=\"mt-9 grid gap-5 lg:grid-cols-[1fr_1fr_.72fr]\" data-kid=\"1-2-3-1-2\">\n                    <a class=\"group min-w-0 rounded-[14px] border border-[#cfd5d8] bg-white p-6 shadow-xs hover:border-[#0FA3B1] sm:p-7\" data-kid=\"1-2-3-1-2-1\" href=\"#programme-acc\">\n                        <div class=\"flex items-start justify-between gap-4\" data-kid=\"1-2-3-1-2-1-1\">\n                            <span class=\"rounded-full bg-[#e7f7f7] px-2.5 py-1 text-[11px] font-bold text-[#0C8793]\" data-kid=\"1-2-3-1-2-1-1-1\">\n                                BSc\n                            </span>\n                            <span class=\"min-w-0 break-all text-right font-mono text-[10px] leading-4 text-[#87919b]\" data-kid=\"1-2-3-1-2-1-1-2\">\n                                ABOTS\n                            </span>\n                        </div>\n                        <h3 class=\"mt-7 max-w-[320px] text-[21px] font-semibold leading-7 tracking-[-0.03em] text-[#172033] group-hover:text-[#0C8793]\" data-kid=\"1-2-3-1-2-1-2\">\n                            Applied botany (Two Options available)\n                        </h3>\n                        <div class=\"mt-6 border-t border-[#e5e7e8] pt-4\" data-kid=\"1-2-3-1-2-1-3\">\n                            <p class=\"text-[11px] font-semibold uppercase tracking-[0.14em] text-[#8a939d]\" data-kid=\"1-2-3-1-2-1-3-1\">\n                                Record details\n                            </p>\n                            <div class=\"mt-3 flex flex-wrap gap-x-5 gap-y-2 text-[13px] text-[#59636f]\" data-kid=\"1-2-3-1-2-1-3-2\">\n                                <span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-2-3-1-2-1-3-2-1\">\n                                    <i class=\"h-3.5 w-3.5 text-[#0FA3B1]\" data-kid=\"1-2-3-1-2-1-3-2-1-1\" data-lucide=\"clock-3\">\n                                    </i>\n                                    3 years\n                                </span>\n                                <span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-2-3-1-2-1-3-2-2\">\n                                    <i class=\"h-3.5 w-3.5 text-[#0FA3B1]\" data-kid=\"1-2-3-1-2-1-3-2-2-1\" data-lucide=\"building-2\">\n                                    </i>\n                                    Faculty record\n                                </span>\n                            </div>\n                        </div>\n                        <div class=\"mt-6 flex items-center justify-between border-t border-[#e5e7e8] pt-4 text-[12px] font-semibold text-[#0C8793]\" data-kid=\"1-2-3-1-2-1-4\">\n                            <span data-kid=\"1-2-3-1-2-1-4-1\">\n                                Open programme record\n                            </span>\n                            <i class=\"h-4 w-4 transition-transform group-hover:translate-x-0.5\" data-kid=\"1-2-3-1-2-1-4-2\" data-lucide=\"arrow-up-right\">\n                            </i>\n                        </div>\n                    </a>\n                    <a class=\"group min-w-0 rounded-[14px] border border-[#cfd5d8] bg-white p-6 shadow-xs hover:border-[#0FA3B1] sm:p-7\" data-kid=\"1-2-3-1-2-2\" href=\"#programme-cds\">\n                        <div class=\"flex items-start justify-between gap-4\" data-kid=\"1-2-3-1-2-2-1\">\n                            <span class=\"rounded-full bg-[#e7f7f7] px-2.5 py-1 text-[11px] font-bold text-[#0C8793]\" data-kid=\"1-2-3-1-2-2-1-1\">\n                                BSc\n                            </span>\n                            <span class=\"min-w-0 break-all text-right font-mono text-[10px] leading-4 text-[#87919b]\" data-kid=\"1-2-3-1-2-2-1-2\">\n                                CDS\n                            </span>\n                        </div>\n                        <h3 class=\"mt-7 max-w-[320px] text-[21px] font-semibold leading-7 tracking-[-0.03em] text-[#172033] group-hover:text-[#0C8793]\" data-kid=\"1-2-3-1-2-2-2\">\n                            B.Sc. Communication and Development Studies\n                        </h3>\n                        <div class=\"mt-6 border-t border-[#e5e7e8] pt-4\" data-kid=\"1-2-3-1-2-2-3\">\n                            <p class=\"text-[11px] font-semibold uppercase tracking-[0.14em] text-[#8a939d]\" data-kid=\"1-2-3-1-2-2-3-1\">\n                                Record details\n                            </p>\n                            <div class=\"mt-3 flex flex-wrap gap-x-5 gap-y-2 text-[13px] text-[#59636f]\" data-kid=\"1-2-3-1-2-2-3-2\">\n                                <span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-2-3-1-2-2-3-2-1\">\n                                    <i class=\"h-3.5 w-3.5 text-[#0FA3B1]\" data-kid=\"1-2-3-1-2-2-3-2-1-1\" data-lucide=\"clock-3\">\n                                    </i>\n                                    Undergraduate\n                                </span>\n                                <span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-2-3-1-2-2-3-2-2\">\n                                    <i class=\"h-3.5 w-3.5 text-[#0FA3B1]\" data-kid=\"1-2-3-1-2-2-3-2-2-1\" data-lucide=\"list-checks\">\n                                    </i>\n                                    Listed requirements\n                                </span>\n                            </div>\n                        </div>\n                        <div class=\"mt-6 flex items-center justify-between border-t border-[#e5e7e8] pt-4 text-[12px] font-semibold text-[#0C8793]\" data-kid=\"1-2-3-1-2-2-4\">\n                            <span data-kid=\"1-2-3-1-2-2-4-1\">\n                                Open programme record\n                            </span>\n                            <i class=\"h-4 w-4 transition-transform group-hover:translate-x-0.5\" data-kid=\"1-2-3-1-2-2-4-2\" data-lucide=\"arrow-up-right\">\n                            </i>\n                        </div>\n                    </a>\n                    <div class=\"flex min-h-[260px] flex-col justify-between rounded-[14px] bg-[#1B2A4A] p-6 text-white shadow-sm sm:p-7\" data-kid=\"1-2-3-1-2-3\">\n                        <div data-kid=\"1-2-3-1-2-3-1\">\n                            <p class=\"text-[11px] font-semibold uppercase tracking-[0.16em] text-[#7edbe2]\" data-kid=\"1-2-3-1-2-3-1-1\">\n                                Catalogue note\n                            </p>\n                            <h3 class=\"mt-4 text-[25px] font-semibold leading-tight tracking-[-0.035em]\" data-kid=\"1-2-3-1-2-3-1-2\">\n                                The record is the source of truth.\n                            </h3>\n                            <p class=\"mt-4 text-[13px] leading-6 text-white/70\" data-kid=\"1-2-3-1-2-3-1-3\">\n                                Codes, duration, academic unit, tuition, and listed requirements should stay visible — even when a description is unavailable.\n                            </p>\n                        </div>\n                        <a class=\"mt-8 inline-flex items-center gap-2 text-[13px] font-semibold text-[#a6edf0]\" data-kid=\"1-2-3-1-2-3-2\" href=\"#all-programmes\">\n                            Browse the catalogue\n                            <i class=\"h-4 w-4\" data-kid=\"1-2-3-1-2-3-2-1\" data-lucide=\"arrow-right\">\n                            </i>\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"border-b border-[#dfe2e5] bg-white\" data-kid=\"1-2-4\" id=\"faculties\">\n            <div class=\"mx-auto max-w-[1200px] px-6 py-16 lg:px-8 lg:py-20\" data-kid=\"1-2-4-1\">\n                <div class=\"grid gap-10 lg:grid-cols-[.8fr_1.2fr] lg:gap-20\" data-kid=\"1-2-4-1-1\">\n                    <div data-kid=\"1-2-4-1-1-1\">\n                        <p class=\"text-[11px] font-semibold uppercase tracking-[0.18em] text-[#0C8793]\" data-kid=\"1-2-4-1-1-1-1\">\n                            Faculties & schools\n                        </p>\n                        <h2 class=\"mt-3 text-[32px] font-semibold leading-tight tracking-[-0.045em] text-[#1B2A4A] sm:text-[38px]\" data-kid=\"1-2-4-1-1-1-2\">\n                            Browse by academic home.\n                        </h2>\n                        <p class=\"mt-4 max-w-[360px] text-[14px] leading-6 text-[#626c78]\" data-kid=\"1-2-4-1-1-1-3\">\n                            Keep the university context in view while you move from a broad academic unit to the programme records inside it.\n                        </p>\n                        <a class=\"mt-7 inline-flex items-center gap-2 text-[13px] font-semibold text-[#0C8793]\" data-kid=\"1-2-4-1-1-1-4\" href=\"#faculties-all\">\n                            See all faculties and schools\n                            <i class=\"h-4 w-4\" data-kid=\"1-2-4-1-1-1-4-1\" data-lucide=\"arrow-up-right\">\n                            </i>\n                        </a>\n                    </div>\n                    <div class=\"overflow-hidden rounded-[14px] border border-[#cfd5d8] bg-[#fbfaf7]\" data-kid=\"1-2-4-1-1-2\">\n                        <div class=\"grid grid-cols-[1fr_auto] border-b border-[#dfe2e5] px-5 py-3 text-[10px] font-semibold uppercase tracking-[0.16em] text-[#8a939d] sm:px-6\" data-kid=\"1-2-4-1-1-2-1\">\n                            <span data-kid=\"1-2-4-1-1-2-1-1\">\n                                Academic unit\n                            </span>\n                            <span data-kid=\"1-2-4-1-1-2-1-2\">\n                                Browse\n                            </span>\n                        </div>\n                        <a class=\"group flex items-center justify-between gap-5 border-b border-[#dfe2e5] px-5 py-5 hover:bg-white sm:px-6\" data-kid=\"1-2-4-1-1-2-2\" href=\"#unit-science\">\n                            <div class=\"flex min-w-0 items-center gap-4\" data-kid=\"1-2-4-1-1-2-2-1\">\n                                <span class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-[#e7f7f7] text-[#0C8793]\" data-kid=\"1-2-4-1-1-2-2-1-1\">\n                                    <i class=\"h-4 w-4\" data-kid=\"1-2-4-1-1-2-2-1-1-1\" data-lucide=\"flask-conical\">\n                                    </i>\n                                </span>\n                                <div class=\"min-w-0\" data-kid=\"1-2-4-1-1-2-2-1-2\">\n                                    <p class=\"truncate text-[15px] font-semibold text-[#172033]\" data-kid=\"1-2-4-1-1-2-2-1-2-1\">\n                                        Faculty of Science\n                                    </p>\n                                    <p class=\"mt-1 text-[12px] text-[#727c87]\" data-kid=\"1-2-4-1-1-2-2-1-2-2\">\n                                        Programme records and requirements\n                                    </p>\n                                </div>\n                            </div>\n                            <i class=\"h-4 w-4 shrink-0 text-[#7d8792] group-hover:text-[#0FA3B1]\" data-kid=\"1-2-4-1-1-2-2-2\" data-lucide=\"arrow-up-right\">\n                            </i>\n                        </a>\n                        <a class=\"group flex items-center justify-between gap-5 border-b border-[#dfe2e5] px-5 py-5 hover:bg-white sm:px-6\" data-kid=\"1-2-4-1-1-2-3\" href=\"#unit-arts\">\n                            <div class=\"flex min-w-0 items-center gap-4\" data-kid=\"1-2-4-1-1-2-3-1\">\n                                <span class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-[#eef0f2] text-[#1B2A4A]\" data-kid=\"1-2-4-1-1-2-3-1-1\">\n                                    <i class=\"h-4 w-4\" data-kid=\"1-2-4-1-1-2-3-1-1-1\" data-lucide=\"landmark\">\n                                    </i>\n                                </span>\n                                <div class=\"min-w-0\" data-kid=\"1-2-4-1-1-2-3-1-2\">\n                                    <p class=\"truncate text-[15px] font-semibold text-[#172033]\" data-kid=\"1-2-4-1-1-2-3-1-2-1\">\n                                        Faculty of Arts\n                                    </p>\n                                    <p class=\"mt-1 text-[12px] text-[#727c87]\" data-kid=\"1-2-4-1-1-2-3-1-2-2\">\n                                        Programme records and requirements\n                                    </p>\n                                </div>\n                            </div>\n                            <i class=\"h-4 w-4 shrink-0 text-[#7d8792] group-hover:text-[#0FA3B1]\" data-kid=\"1-2-4-1-1-2-3-2\" data-lucide=\"arrow-up-right\">\n                            </i>\n                        </a>\n                        <a class=\"group flex items-center justify-between gap-5 border-b border-[#dfe2e5] px-5 py-5 hover:bg-white sm:px-6\" data-kid=\"1-2-4-1-1-2-4\" href=\"#unit-education\">\n                            <div class=\"flex min-w-0 items-center gap-4\" data-kid=\"1-2-4-1-1-2-4-1\">\n                                <span class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-[#eef0f2] text-[#1B2A4A]\" data-kid=\"1-2-4-1-1-2-4-1-1\">\n                                    <i class=\"h-4 w-4\" data-kid=\"1-2-4-1-1-2-4-1-1-1\" data-lucide=\"school\">\n                                    </i>\n                                </span>\n                                <div class=\"min-w-0\" data-kid=\"1-2-4-1-1-2-4-1-2\">\n                                    <p class=\"truncate text-[15px] font-semibold text-[#172033]\" data-kid=\"1-2-4-1-1-2-4-1-2-1\">\n                                        Faculty of Education\n                                    </p>\n                                    <p class=\"mt-1 text-[12px] text-[#727c87]\" data-kid=\"1-2-4-1-1-2-4-1-2-2\">\n                                        Programme records and requirements\n                                    </p>\n                                </div>\n                            </div>\n                            <i class=\"h-4 w-4 shrink-0 text-[#7d8792] group-hover:text-[#0FA3B1]\" data-kid=\"1-2-4-1-1-2-4-2\" data-lucide=\"arrow-up-right\">\n                            </i>\n                        </a>\n                        <a class=\"group flex items-center justify-between gap-5 px-5 py-5 hover:bg-white sm:px-6\" data-kid=\"1-2-4-1-1-2-5\" href=\"#unit-technology\">\n                            <div class=\"flex min-w-0 items-center gap-4\" data-kid=\"1-2-4-1-1-2-5-1\">\n                                <span class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-[#eef0f2] text-[#1B2A4A]\" data-kid=\"1-2-4-1-1-2-5-1-1\">\n                                    <i class=\"h-4 w-4\" data-kid=\"1-2-4-1-1-2-5-1-1-1\" data-lucide=\"settings-2\">\n                                    </i>\n                                </span>\n                                <div class=\"min-w-0\" data-kid=\"1-2-4-1-1-2-5-1-2\">\n                                    <p class=\"truncate text-[15px] font-semibold text-[#172033]\" data-kid=\"1-2-4-1-1-2-5-1-2-1\">\n                                        Academic units\n                                    </p>\n                                    <p class=\"mt-1 text-[12px] text-[#727c87]\" data-kid=\"1-2-4-1-1-2-5-1-2-2\">\n                                        Explore the selected university directory\n                                    </p>\n                                </div>\n                            </div>\n                            <i class=\"h-4 w-4 shrink-0 text-[#7d8792] group-hover:text-[#0FA3B1]\" data-kid=\"1-2-4-1-1-2-5-2\" data-lucide=\"arrow-up-right\">\n                            </i>\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"bg-[#1B2A4A] text-white\" data-kid=\"1-2-5\" id=\"advisor\">\n            <div class=\"mx-auto max-w-[1200px] px-6 py-14 lg:px-8 lg:py-16\" data-kid=\"1-2-5-1\">\n                <div class=\"grid items-center gap-8 lg:grid-cols-[1fr_auto] lg:gap-16\" data-kid=\"1-2-5-1-1\">\n                    <div data-kid=\"1-2-5-1-1-1\">\n                        <p class=\"text-[11px] font-semibold uppercase tracking-[0.18em] text-[#7edbe2]\" data-kid=\"1-2-5-1-1-1-1\">\n                            Before you apply\n                        </p>\n                        <h2 class=\"mt-3 max-w-[650px] text-[32px] font-semibold leading-tight tracking-[-0.045em] sm:text-[40px]\" data-kid=\"1-2-5-1-1-1-2\">\n                            Use the guidance. Verify the decision.\n                        </h2>\n                        <p class=\"mt-4 max-w-[630px] text-[15px] leading-7 text-white/70\" data-kid=\"1-2-5-1-1-1-3\">\n                            USPA helps you search, compare, and review listed requirements. It does not replace the institution’s final admissions decision.\n                        </p>\n                    </div>\n                    <div class=\"flex flex-wrap gap-3 lg:justify-end\" data-kid=\"1-2-5-1-1-2\">\n                        <a class=\"inline-flex items-center gap-2 rounded-md bg-[#0FA3B1] px-5 py-3 text-[13px] font-semibold text-white hover:bg-[#0C8793]\" data-kid=\"1-2-5-1-1-2-1\" href=\"#eligibility\">\n                            Check eligibility\n                            <i class=\"h-4 w-4\" data-kid=\"1-2-5-1-1-2-1-1\" data-lucide=\"arrow-right\">\n                            </i>\n                        </a>\n                        <a class=\"inline-flex items-center gap-2 rounded-md border border-white/30 px-5 py-3 text-[13px] font-semibold text-white hover:border-[#7edbe2] hover:bg-white/5\" data-kid=\"1-2-5-1-1-2-2\" href=\"#programmes\">\n                            Browse programmes\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </section>\n    </main>\n    <footer class=\"bg-[#14233f] text-white\" data-kid=\"1-3\">\n        <div class=\"mx-auto max-w-[1200px] px-6 py-12 lg:px-8\" data-kid=\"1-3-1\">\n            <div class=\"grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr]\" data-kid=\"1-3-1-1\">\n                <div data-kid=\"1-3-1-1-1\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-3-1-1-1-1\">\n                        <span class=\"flex h-9 w-9 items-center justify-center rounded-[9px] bg-[#0FA3B1]\" data-kid=\"1-3-1-1-1-1-1\">\n                            <i class=\"h-4 w-4\" data-kid=\"1-3-1-1-1-1-1-1\" data-lucide=\"graduation-cap\">\n                            </i>\n                        </span>\n                        <span class=\"text-[17px] font-bold\" data-kid=\"1-3-1-1-1-1-2\">\n                            USPA\n                        </span>\n                    </div>\n                    <p class=\"mt-4 max-w-[280px] text-[13px] leading-6 text-white/60\" data-kid=\"1-3-1-1-1-2\">\n                        Smart Programme Advisor — helping prospective students discover and review academic programmes.\n                    </p>\n                    <p class=\"mt-4 text-[11px] text-white/40\" data-kid=\"1-3-1-1-1-3\">\n                        Platform by Bamenda Tech Research Center (BTRC).\n                    </p>\n                </div>\n                <div data-kid=\"1-3-1-1-2\">\n                    <h3 class=\"text-[12px] font-semibold uppercase tracking-[0.15em] text-white/80\" data-kid=\"1-3-1-1-2-1\">\n                        Quick links\n                    </h3>\n                    <div class=\"mt-4 space-y-3 text-[13px] text-white/60\" data-kid=\"1-3-1-1-2-2\">\n                        <a class=\"block hover:text-[#7edbe2]\" data-kid=\"1-3-1-1-2-2-1\" href=\"#programmes\">\n                            Browse programmes\n                        </a>\n                        <a class=\"block hover:text-[#7edbe2]\" data-kid=\"1-3-1-1-2-2-2\" href=\"#faculties\">\n                            Faculties & departments\n                        </a>\n                        <a class=\"block hover:text-[#7edbe2]\" data-kid=\"1-3-1-1-2-2-3\" href=\"#eligibility\">\n                            Check eligibility\n                        </a>\n                        <a class=\"block hover:text-[#7edbe2]\" data-kid=\"1-3-1-1-2-2-4\" href=\"#advisor\">\n                            AI Advisor\n                        </a>\n                    </div>\n                </div>\n                <div data-kid=\"1-3-1-1-3\">\n                    <h3 class=\"text-[12px] font-semibold uppercase tracking-[0.15em] text-white/80\" data-kid=\"1-3-1-1-3-1\">\n                        Resources\n                    </h3>\n                    <div class=\"mt-4 space-y-3 text-[13px] text-white/60\" data-kid=\"1-3-1-1-3-2\">\n                        <a class=\"block hover:text-[#7edbe2]\" data-kid=\"1-3-1-1-3-2-1\" href=\"#requirements\">\n                            Admission requirements\n                        </a>\n                        <a class=\"block hover:text-[#7edbe2]\" data-kid=\"1-3-1-1-3-2-2\" href=\"#programmes\">\n                            Academic catalogue\n                        </a>\n                        <a class=\"block hover:text-[#7edbe2]\" data-kid=\"1-3-1-1-3-2-3\" href=\"#tuition\">\n                            Tuition & fees\n                        </a>\n                        <a class=\"block hover:text-[#7edbe2]\" data-kid=\"1-3-1-1-3-2-4\" href=\"#questions\">\n                            Questions & guidance\n                        </a>\n                    </div>\n                </div>\n                <div data-kid=\"1-3-1-1-4\">\n                    <h3 class=\"text-[12px] font-semibold uppercase tracking-[0.15em] text-white/80\" data-kid=\"1-3-1-1-4-1\">\n                        Contact\n                    </h3>\n                    <div class=\"mt-4 space-y-3 text-[13px] text-white/60\" data-kid=\"1-3-1-1-4-2\">\n                        <p class=\"flex items-center gap-2\" data-kid=\"1-3-1-1-4-2-1\">\n                            <i class=\"h-4 w-4 text-[#7edbe2]\" data-kid=\"1-3-1-1-4-2-1-1\" data-lucide=\"mail\">\n                            <