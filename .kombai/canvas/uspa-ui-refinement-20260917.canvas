d text-[#0FA3B1] no-underline\" data-kid=\"1-2-3-1-2-1-2-4-2-3\" data-name=\"details link\" href=\"#\">\n                                        Details\n                                        <i class=\"h-3 w-3\" data-kid=\"1-2-3-1-2-1-2-4-2-3-1\" data-lucide=\"arrow-right\" data-name=\"arrow right icon\">\n                                        </i>\n                                    </a>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <aside aria-label=\"Eligibility preview\" class=\"border border-[#D9DED9] bg-[#F0F6F4] p-6\" data-kid=\"1-2-3-1-2-2\" data-name=\"eligibility preview aside\" id=\"eligibility\">\n                        <div class=\"flex items-start justify-between gap-4\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"aside header\">\n                            <div data-kid=\"1-2-3-1-2-2-1-1\" data-name=\"aside header text container\">\n                                <p class=\"eyebrow text-[10px] font-bold text-[#218A4D]\" data-kid=\"1-2-3-1-2-2-1-1-1\" data-name=\"aside eyebrow text\">\n                                    Requirements preview\n                                </p>\n                                <h3 class=\"mt-2 text-[21px] font-bold tracking-[-0.03em] text-[#17233D]\" data-kid=\"1-2-3-1-2-2-1-1-2\" data-name=\"aside title\">\n                                    Check before you commit\n                                </h3>\n                            </div>\n                            <span class=\"flex h-9 w-9 items-center justify-center rounded-lg bg-white text-[#218A4D]\" data-kid=\"1-2-3-1-2-2-1-2\" data-name=\"clipboard icon container\">\n                                <i class=\"h-5 w-5\" data-kid=\"1-2-3-1-2-2-1-2-1\" data-lucide=\"clipboard-check\" data-name=\"clipboard icon\">\n                                </i>\n                            </span>\n                        </div>\n                        <p class=\"mt-3 text-[13px] leading-5 text-[#526070]\" data-kid=\"1-2-3-1-2-2-2\" data-name=\"aside description text\">\n                            Enter your O/A Level subjects to see which listed programmes may fit your results.\n                        </p>\n                        <div class=\"mt-6 border-l-2 border-[#2ECC71] pl-4\" data-kid=\"1-2-3-1-2-2-3\" data-name=\"evidence example container\">\n                            <p class=\"text-[12px] font-bold text-[#218A4D]\" data-kid=\"1-2-3-1-2-2-3-1\" data-name=\"example title\">\n                                Example evidence\n                            </p>\n                            <div class=\"mt-3 space-y-2.5 text-[13px] text-[#334155]\" data-kid=\"1-2-3-1-2-2-3-2\" data-name=\"evidence list\">\n                                <div class=\"flex items-center justify-between\" data-kid=\"1-2-3-1-2-2-3-2-1\" data-name=\"english language evidence\">\n                                    <span class=\"flex items-center gap-2\" data-kid=\"1-2-3-1-2-2-3-2-1-1\" data-name=\"check icon\">\n                                        <i class=\"h-3.5 w-3.5 text-[#218A4D]\" data-kid=\"1-2-3-1-2-2-3-2-1-1-1\" data-lucide=\"check\">\n                                        </i>\n                                        English Language\n                                    </span>\n                                    <span class=\"font-bold text-[#218A4D]\" data-kid=\"1-2-3-1-2-2-3-2-1-2\" data-name=\"evidence status\">\n                                        Credit\n                                    </span>\n                                </div>\n                                <div class=\"flex items-center justify-between\" data-kid=\"1-2-3-1-2-2-3-2-2\" data-name=\"math evidence\">\n                                    <span class=\"flex items-center gap-2\" data-kid=\"1-2-3-1-2-2-3-2-2-1\" data-name=\"check icon\">\n                                        <i class=\"h-3.5 w-3.5 text-[#218A4D]\" data-kid=\"1-2-3-1-2-2-3-2-2-1-1\" data-lucide=\"check\">\n                                        </i>\n                                        Mathematics\n                                    </span>\n                                    <span class=\"font-bold text-[#218A4D]\" data-kid=\"1-2-3-1-2-2-3-2-2-2\" data-name=\"evidence status\">\n                                        Credit\n                                    </span>\n                                </div>\n                                <div class=\"flex items-center justify-between\" data-kid=\"1-2-3-1-2-2-3-2-3\" data-name=\"programme rules evidence\">\n                                    <span class=\"flex items-center gap-2\" data-kid=\"1-2-3-1-2-2-3-2-3-1\" data-name=\"minus icon\">\n                                        <i class=\"h-3.5 w-3.5 text-[#B66D08]\" data-kid=\"1-2-3-1-2-2-3-2-3-1-1\" data-lucide=\"minus\">\n                                        </i>\n                                        Programme rules\n                                    </span>\n                                    <span class=\"font-semibold text-[#B66D08]\" data-kid=\"1-2-3-1-2-2-3-2-3-2\" data-name=\"evidence status\">\n                                        Review\n                                    </span>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"mt-6 rounded-lg border border-[#D4E2DD] bg-white/70 p-3\" data-kid=\"1-2-3-1-2-2-4\" data-name=\"disclaimer container\">\n                            <p class=\"flex items-start gap-2 text-[11px] leading-4 text-[#526070]\" data-kid=\"1-2-3-1-2-2-4-1\" data-name=\"disclaimer text\">\n                                <i class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-[#0FA3B1]\" data-kid=\"1-2-3-1-2-2-4-1-1\" data-lucide=\"info\" data-name=\"info icon\">\n                                </i>\n                                These results are guidance based on listed requirements, not an official admission decision.\n                            </p>\n                        </div>\n                        <a class=\"focus-ring mt-5 flex w-full items-center justify-center gap-2 rounded-lg bg-[#1B2A4A] px-4 py-3 text-[13px] font-bold text-white no-underline hover:bg-[#0F1B33]\" data-kid=\"1-2-3-1-2-2-5\" data-name=\"check eligibility cta button\" href=\"#\">\n                            Check your eligibility\n                            <i class=\"h-4 w-4\" data-kid=\"1-2-3-1-2-2-5-1\" data-lucide=\"arrow-right\" data-name=\"arrow right icon\">\n                            </i>\n                        </a>\n                    </aside>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"faculty-title\" class=\"border-y border-[#E2E2DD] bg-[#FFFDF9] py-14\" data-kid=\"1-2-4\" data-name=\"faculties section\" id=\"faculties\">\n            <div class=\"mx-auto max-w-[1200px] px-8\" data-kid=\"1-2-4-1\" data-name=\"section container\">\n                <div class=\"flex flex-col justify-between gap-4 sm:flex-row sm:items-end\" data-kid=\"1-2-4-1-1\" data-name=\"section header\">\n                    <div data-kid=\"1-2-4-1-1-1\" data-name=\"section header text container\">\n                        <p class=\"eyebrow text-[11px] font-semibold text-[#0FA3B1]\" data-kid=\"1-2-4-1-1-1-1\" data-name=\"section eyebrow text\">\n                            Explore by academic unit\n                        </p>\n                        <h2 class=\"mt-3 text-[30px] font-bold tracking-[-0.04em] text-[#17233D]\" data-kid=\"1-2-4-1-1-1-2\" data-name=\"section title\" id=\"faculty-title\">\n                            Faculties & schools\n                        </h2>\n                    </div>\n                    <a class=\"flex items-center gap-2 text-[14px] font-bold text-[#1B2A4A] no-underline\" data-kid=\"1-2-4-1-1-2\" data-name=\"browse all units link\" href=\"#\">\n                        Browse all units\n                        <i class=\"h-4 w-4 text-[#0FA3B1]\" data-kid=\"1-2-4-1-1-2-1\" data-lucide=\"arrow-up-right\" data-name=\"arrow up right icon\">\n                        </i>\n                    </a>\n                </div>\n                <div class=\"mt-8 grid gap-x-10 gap-y-0 md:grid-cols-2\" data-kid=\"1-2-4-1-2\" data-name=\"units grid container\">\n                    <a class=\"group flex items-center justify-between border-t border-[#E3E5E1] py-4 no-underline\" data-kid=\"1-2-4-1-2-1\" data-name=\"faculty 1 card\" href=\"#\">\n                        <span data-kid=\"1-2-4-1-2-1-1\" data-name=\"faculty info container\">\n                            <span class=\"block text-[14px] font-bold text-[#17233D] group-hover:text-[#0FA3B1]\" data-kid=\"1-2-4-1-2-1-1-1\" data-name=\"faculty title\">\n                                Faculty of Science\n                            </span>\n                            <span class=\"mt-1 block text-[12px] text-[#667085]\" data-kid=\"1-2-4-1-2-1-1-2\" data-name=\"faculty description\">\n                                Programmes in science and applied disciplines\n                            </span>\n                        </span>\n                        <span class=\"flex items-center gap-3\" data-kid=\"1-2-4-1-2-1-2\" data-name=\"faculty action container\">\n                            <span class=\"text-[12px] font-semibold text-[#8A929A]\" data-kid=\"1-2-4-1-2-1-2-1\" data-name=\"programme count\">\n                                48 listed\n                            </span>\n                            <i class=\"h-4 w-4 text-[#8A929A] group-hover:text-[#0FA3B1]\" data-kid=\"1-2-4-1-2-1-2-2\" data-lucide=\"arrow-up-right\" data-name=\"arrow up right icon\">\n                            </i>\n                        </span>\n                    </a>\n                    <a class=\"group flex items-center justify-between border-t border-[#E3E5E1] py-4 no-underline\" data-kid=\"1-2-4-1-2-2\" data-name=\"faculty 2 card\" href=\"#\">\n                        <span data-kid=\"1-2-4-1-2-2-1\" data-name=\"faculty info container\">\n                            <span class=\"block text-[14px] font-bold text-[#17233D] group-hover:text-[#0FA3B1]\" data-kid=\"1-2-4-1-2-2-1-1\" data-name=\"faculty title\">\n                                Faculty of Arts\n                            </span>\n                            <span class=\"mt-1 block text-[12px] text-[#667085]\" data-kid=\"1-2-4-1-2-2-1-2\" data-name=\"faculty description\">\n                                Languages, history, culture, and communication\n                            </span>\n                        </span>\n                        <span class=\"flex items-center gap-3\" data-kid=\"1-2-4-1-2-2-2\" data-name=\"faculty action container\">\n                            <span class=\"text-[12px] font-semibold text-[#8A929A]\" data-kid=\"1-2-4-1-2-2-2-1\" data-name=\"programme count\">\n                                32 listed\n                            </span>\n                            <i class=\"h-4 w-4 text-[#8A929A] group-hover:text-[#0FA3B1]\" data-kid=\"1-2-4-1-2-2-2-2\" data-lucide=\"arrow-up-right\" data-name=\"arrow up right icon\">\n                            </i>\n                        </span>\n                    </a>\n                    <a class=\"group flex items-center justify-between border-t border-[#E3E5E1] py-4 no-underline\" data-kid=\"1-2-4-1-2-3\" data-name=\"faculty 3 card\" href=\"#\">\n                        <span data-kid=\"1-2-4-1-2-3-1\" data-name=\"faculty info container\">\n                            <span class=\"block text-[14px] font-bold text-[#17233D] group-hover:text-[#0FA3B1]\" data-kid=\"1-2-4-1-2-3-1-1\" data-name=\"faculty title\">\n                                School of Business\n                            </span>\n                            <span class=\"mt-1 block text-[12px] text-[#667085]\" data-kid=\"1-2-4-1-2-3-1-2\" data-name=\"faculty description\">\n                                Accounting, management, and entrepreneurship\n                            </span>\n                        </span>\n                        <span class=\"flex items-center gap-3\" data-kid=\"1-2-4-1-2-3-2\" data-name=\"faculty action container\">\n                            <span class=\"text-[12px] font-semibold text-[#8A929A]\" data-kid=\"1-2-4-1-2-3-2-1\" data-name=\"programme count\">\n                                27 listed\n                            </span>\n                            <i class=\"h-4 w-4 text-[#8A929A] group-hover:text-[#0FA3B1]\" data-kid=\"1-2-4-1-2-3-2-2\" data-lucide=\"arrow-up-right\" data-name=\"arrow up right icon\">\n                            </i>\n                        </span>\n                    </a>\n                    <a class=\"group flex items-center justify-between border-t border-[#E3E5E1] py-4 no-underline\" data-kid=\"1-2-4-1-2-4\" data-name=\"faculty 4 card\" href=\"#\">\n                        <span data-kid=\"1-2-4-1-2-4-1\" data-name=\"faculty info container\">\n                            <span class=\"block text-[14px] font-bold text-[#17233D] group-hover:text-[#0FA3B1]\" data-kid=\"1-2-4-1-2-4-1-1\" data-name=\"faculty title\">\n                                Higher Technical Education\n                            </span>\n                            <span class=\"mt-1 block text-[12px] text-[#667085]\" data-kid=\"1-2-4-1-2-4-1-2\" data-name=\"faculty description\">\n                                Professional and technical programme routes\n                            </span>\n                        </span>\n                        <span class=\"flex items-center gap-3\" data-kid=\"1-2-4-1-2-4-2\" data-name=\"faculty action container\">\n                            <span class=\"text-[12px] font-semibold text-[#8A929A]\" data-kid=\"1-2-4-1-2-4-2-1\" data-name=\"programme count\">\n                                41 listed\n                            </span>\n                            <i class=\"h-4 w-4 text-[#8A929A] group-hover:text-[#0FA3B1]\" data-kid=\"1-2-4-1-2-4-2-2\" data-lucide=\"arrow-up-right\" data-name=\"arrow up right icon\">\n                            </i>\n                        </span>\n                    </a>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"cta-title\" class=\"bg-[#1B2A4A] py-14 text-white\" data-kid=\"1-2-5\" data-name=\"call to action section\" id=\"advisor\">\n            <div class=\"mx-auto flex max-w-[1200px] flex-col items-start justify-between gap-8 px-8 md:flex-row md:items-center\" data-kid=\"1-2-5-1\" data-name=\"section container\">\n                <div class=\"max-w-[620px]\" data-kid=\"1-2-5-1-1\" data-name=\"section text container\">\n                    <p class=\"eyebrow text-[11px] font-semibold text-[#67D9DB]\" data-kid=\"1-2-5-1-1-1\" data-name=\"section eyebrow text\">\n                        Ready for a closer look?\n                    </p>\n                    <h2 class=\"mt-3 text-[31px] font-bold tracking-[-0.04em] text-[#FFFDF9]\" data-kid=\"1-2-5-1-1-2\" data-name=\"section title\" id=\"cta-title\">\n                        Move from a broad search to a shortlist you can verify.\n                    </h2>\n                    <p class=\"mt-3 text-[14px] leading-6 text-[#C7D3DD]\" data-kid=\"1-2-5-1-1-3\" data-name=\"section description\">\n                        Check eligibility, open the programme requirements, and confirm details with the institution before applying.\n                    </p>\n                </div>\n                <div class=\"flex flex-wrap gap-3\" data-kid=\"1-2-5-1-2\" data-name=\"cta buttons container\">\n                    <a class=\"focus-ring flex items-center gap-2 rounded-lg bg-[#0FA3B1] px-5 py-3 text-[14px] font-bold text-white no-underline hover:bg-[#0C8793]\" data-kid=\"1-2-5-1-2-1\" data-name=\"check eligibility cta button\" href=\"#eligibility\">\n                        Check eligibility\n                        <i class=\"h-4 w-4\" data-kid=\"1-2-5-1-2-1-1\" data-lucide=\"arrow-right\" data-name=\"arrow right icon\">\n                        </i>\n                    </a>\n                    <a class=\"focus-ring flex items-center gap-2 rounded-lg border border-white/25 px-5 py-3 text-[14px] font-bold text-white no-underline hover:bg-white/10\" data-kid=\"1-2-5-1-2-2\" data-name=\"browse programmes cta button\" href=\"#programmes\">\n                        Browse programmes\n                        <i class=\"h-4 w-4\" data-kid=\"1-2-5-1-2-2-1\" data-lucide=\"book-open\" data-name=\"book open icon\">\n                        </i>\n                    </a>\n                </div>\n            </div>\n        </section>\n    </main>\n    <footer class=\"bg-[#13233F] text-[#B9C7D2]\" data-kid=\"1-3\" data-name=\"footer section\">\n        <div class=\"mx-auto max-w-[1200px] px-8 py-10\" data-kid=\"1-3-1\" data-name=\"footer container\">\n            <div class=\"grid gap-8 md:grid-cols-[1.35fr_1fr_1fr_1fr]\" data-kid=\"1-3-1-1\" data-name=\"footer grid container\">\n                <div data-kid=\"1-3-1-1-1\" data-name=\"branding column\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-3-1-1-1-1\" data-name=\"logo container\">\n                        <span class=\"flex h-9 w-9 items-center justify-center rounded-lg bg-[#0FA3B1] text-white\" data-kid=\"1-3-1-1-1-1-1\" data-name=\"graduation cap icon container\">\n                            <i class=\"h-4 w-4\" data-kid=\"1-3-1-1-1-1-1-1\" data-lucide=\"graduation-cap\" data-name=\"graduation cap icon\">\n                            </i>\n                        </span>\n                        <span class=\"text-[17px] font-bold text-white\" data-kid=\"1-3-1-1-1-1-2\" data-name=\"brand name\">\n                            USPA\n                        </span>\n                    </div>\n                    <p class=\"mt-4 max-w-[280px] text-[13px] leading-5 text-[#93A5B3]\" data-kid=\"1-3-1-1-1-2\" data-name=\"brand description\">\n                        Smart Programme Advisor — helping prospective students discover academic programmes.\n                    </p>\n                    <p class=\"mt-4 text-[11px] text-[#718697]\" data-kid=\"1-3-1-1-1-3\" data-name=\"copyright info\">\n                        Platform by Bamenda Tech Research Center (BTRC).\n                    </p>\n                </div>\n                <div data-kid=\"1-3-1-1-2\" data-name=\"explore link column\">\n                    <h3 class=\"text-[12px] font-bold uppercase tracking-[.12em] text-white\" data-kid=\"1-3-1-1-2-1\" data-name=\"explore column title\">\n                        Explore\n                    </h3>\n                    <ul class=\"mt-4 space-y-3 text-[13px]\" data-kid=\"1-3-1-1-2-2\" data-name=\"explore links list\">\n                        <li data-kid=\"1-3-1-1-2-2-1\" data-name=\"browse programmes list item\">\n                            <a class=\"no-underline hover:text-[#67D9DB]\" data-kid=\"1-3-1-1-2-2-1-1\" data-name=\"browse programmes link\" href=\"#programmes\">\n                                Browse programmes\n                            </a>\n                        </li>\n                        <li data-kid=\"1-3-1-1-2-2-2\" data-name=\"faculties list item\">\n                            <a class=\"no-underline hover:text-[#67D9DB]\" data-kid=\"1-3-1-1-2-2-2-1\" data-name=\"faculties link\" href=\"#faculties\">\n                                Faculties & schools\n                            </a>\n                        </li>\n                        <li data-kid=\"1-3-1-1-2-2-3\" data-name=\"eligibility list item\">\n                            <a class=\"no-underline hover:text-[#67D9DB]\" data-kid=\"1-3-1-1-2-2-3-1\" data-name=\"eligibility link\" href=\"#eligibility\">\n                                Check eligibility\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"1-3-1-1-3\" data-name=\"guidance link column\">\n                    <h3 class=\"text-[12px] font-bold uppercase tracking-[.12em] text-white\" data-kid=\"1-3-1-1-3-1\" data-name=\"guidance column title\">\n                        Guidance\n                    </h3>\n                    <ul class=\"mt-4 space-y-3 text-[13px]\" data-kid=\"1-3-1-1-3-2\" data-name=\"guidance links list\">\n                        <li data-kid=\"1-3-1-1-3-2-1\" data-name=\"admission req list item\">\n                            <a class=\"no-underline hover:text-[#67D9DB]\" data-kid=\"1-3-1-1-3-2-1-1\" data-name=\"admission req link\" href=\"#\">\n                                Admission requirements\n                            </a>\n                        </li>\n                        <li data-kid=\"1-3-1-1-3-2-2\" data-name=\"tuition list item\">\n                            <a class=\"no-underline hover:text-[#67D9DB]\" data-kid=\"1-3-1-1-3-2-2-1\" data-name=\"tuition link\" href=\"#\">\n                                Tuition & fees\n                            </a>\n                        </li>\n                        <li data-kid=\"1-3-1-1-3-2-3\" data-name=\"ai advisor list item\">\n                            <a class=\"no-underline hover:text-[#67D9DB]\" data-kid=\"1-3-1-1-3-2-3-1\" data-name=\"ai advisor link\" href=\"#\">\n                                AI Advisor\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"1-3-1-1-4\" data-name=\"contact column\">\n                    <h3 class=\"text-[12px] font-bold uppercase tracking-[.12em] text-white\" data-kid=\"1-3-1-1-4-1\" data-name=\"contact column title\">\n                        Contact\n                    </h3>\n                    <div class=\"mt-4 space-y-3 text-[13px]\" data-kid=\"1-3-1-1-4-2\" data-name=\"contact details container\">\n                        <p class=\"flex items-center gap-2\" data-kid=\"1-3-1-1-4-2-1\" data-name=\"email address\">\n                            <i class=\"h-4 w-4 text-[#4DD4D9]\" data-kid=\"1-3-1-1-4-2-1-1\" data-lucide=\"mail\" data-name=\"mail icon\">\n                            </i>\n                            btrcbambili@gmail.com\n                        </p>\n                        <p class=\"flex items-center gap-2\" data-kid=\"1-3-1-1-4-2-2\" data-name=\"phone number\">\n                            <i class=\"h-4 w-4 text-[#4DD4D9]\" data-kid=\"1-3-1-1-4-2-2-1\" data-lucide=\"phone\" data-name=\"phone icon\">\n                            </i>\n                            +237 683 004 478\n                        </p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"mt-9 border-t border-white/10 pt-5 text-center text-[11px] text-[#718697]\" data-kid=\"1-3-1-2\" data-name=\"footer copyright notice\">\n                © 2026 USPA. Platform by Bamenda Tech Research Center (BTRC). All rights reserved.\n            </div>\n        </div>\n    </footer>\n</div>\n<script>\n    lucide.createIcons();\n</script>\n",
