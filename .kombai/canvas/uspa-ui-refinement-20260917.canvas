    "var_3441d197715f": {
      "type": "variant",
      "label": "USPA — Data-first academic catalogue",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap');\n  .uspa-page { font-family: 'Geist', 'DM Sans', ui-sans-serif, system-ui, sans-serif; }\n  .uspa-page .tabular { font-variant-numeric: tabular-nums; }\n  .uspa-page .soft-rule { border-color: rgba(27,42,74,.12); }\n  .uspa-page .eyebrow { letter-spacing: .14em; text-transform: uppercase; }\n  .uspa-page .focus-ring:focus-visible { outline: 3px solid rgba(15,163,177,.32); outline-offset: 3px; }\n</style>\n<script src=\"https://unpkg.com/lucide@latest/dist/umd/lucide.js\">\n</script>\n<div class=\"uspa-page min-h-screen bg-[#F7F5F0] text-[#17233D]\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"border-b border-[#DCE0E4] bg-[#FFFDF9]\" data-kid=\"1-1\" data-name=\"header section\">\n        <div class=\"mx-auto flex h-[76px] max-w-[1200px] items-center justify-between px-8\" data-kid=\"1-1-1\" data-name=\"header content container\">\n            <div class=\"flex items-center gap-8\" data-kid=\"1-1-1-1\" data-name=\"header logo and department selector\">\n                <a aria-label=\"USPA home\" class=\"focus-ring flex items-center gap-3 no-underline\" data-kid=\"1-1-1-1-1\" data-name=\"home page link\" href=\"#\">\n                    <span class=\"flex h-10 w-10 items-center justify-center rounded-xl bg-[#1B2A4A] text-white shadow-sm\" data-kid=\"1-1-1-1-1-1\" data-name=\"graduation cap icon container\">\n                        <i class=\"h-5 w-5\" data-kid=\"1-1-1-1-1-1-1\" data-lucide=\"graduation-cap\" data-name=\"graduation cap icon\">\n                        </i>\n                    </span>\n                    <span class=\"flex items-baseline gap-2\" data-kid=\"1-1-1-1-1-2\" data-name=\"logo text container\">\n                        <span class=\"text-[19px] font-bold tracking-[-0.03em] text-[#17233D]\" data-kid=\"1-1-1-1-1-2-1\" data-name=\"brand name\">\n                            USPA\n                        </span>\n                        <span class=\"text-[12px] font-medium text-[#667085]\" data-kid=\"1-1-1-1-1-2-2\" data-name=\"brand subtitle\">\n                            Smart Advisor\n                        </span>\n                    </span>\n                </a>\n                <div class=\"hidden h-7 w-px bg-[#DCE0E4] lg:block\" data-kid=\"1-1-1-1-2\" data-name=\"header separator\">\n                </div>\n                <button class=\"focus-ring hidden items-center gap-2 rounded-lg border border-[#D7DDE2] bg-[#F4F5F3] px-3 py-2 text-[13px] font-semibold text-[#1B2A4A] lg:flex\" data-kid=\"1-1-1-1-3\" data-name=\"institution selector button\">\n                    <i class=\"h-4 w-4 text-[#0FA3B1]\" data-kid=\"1-1-1-1-3-1\" data-lucide=\"building-2\" data-name=\"building icon\">\n                    </i>\n                    The University of Bamenda\n                    <i class=\"h-3.5 w-3.5 text-[#667085]\" data-kid=\"1-1-1-1-3-2\" data-lucide=\"chevron-down\" data-name=\"chevron down icon\">\n                    </i>\n                </button>\n            </div>\n            <nav aria-label=\"Main navigation\" class=\"hidden items-center gap-1 md:flex\" data-kid=\"1-1-1-2\" data-name=\"main navigation menu\">\n                <a class=\"focus-ring rounded-lg px-3 py-2 text-[14px] font-semibold text-[#1B2A4A] no-underline hover:bg-[#EEF4F3]\" data-kid=\"1-1-1-2-1\" data-name=\"programmes navigation link\" href=\"#programmes\">\n                    Programmes\n                </a>\n                <a class=\"focus-ring rounded-lg px-3 py-2 text-[14px] font-medium text-[#667085] no-underline hover:bg-[#EEF4F3]\" data-kid=\"1-1-1-2-2\" data-name=\"faculties navigation link\" href=\"#faculties\">\n                    Faculties\n                </a>\n                <a class=\"focus-ring rounded-lg px-3 py-2 text-[14px] font-medium text-[#667085] no-underline hover:bg-[#EEF4F3]\" data-kid=\"1-1-1-2-3\" data-name=\"eligibility navigation link\" href=\"#eligibility\">\n                    Eligibility\n                </a>\n                <a class=\"focus-ring rounded-lg px-3 py-2 text-[14px] font-medium text-[#667085] no-underline hover:bg-[#EEF4F3]\" data-kid=\"1-1-1-2-4\" data-name=\"ai advisor navigation link\" href=\"#advisor\">\n                    AI Advisor\n                </a>\n            </nav>\n            <div class=\"flex items-center gap-2\" data-kid=\"1-1-1-3\" data-name=\"header utility actions container\">\n                <button aria-label=\"Search\" class=\"focus-ring hidden h-10 w-10 items-center justify-center rounded-lg text-[#526070] hover:bg-[#EEF4F3] sm:flex\" data-kid=\"1-1-1-3-1\" data-name=\"search button\">\n                    <i class=\"h-5 w-5\" data-kid=\"1-1-1-3-1-1\" data-lucide=\"search\" data-name=\"search icon\">\n                    </i>\n                </button>\n                <button aria-label=\"Toggle theme\" class=\"focus-ring hidden h-10 w-10 items-center justify-center rounded-lg text-[#526070] hover:bg-[#EEF4F3] sm:flex\" data-kid=\"1-1-1-3-2\" data-name=\"theme toggle button\">\n                    <i class=\"h-[18px] w-[18px]\" data-kid=\"1-1-1-3-2-1\" data-lucide=\"moon\" data-name=\"moon icon\">\n                    </i>\n                </button>\n                <a class=\"focus-ring hidden rounded-lg px-3 py-2 text-[14px] font-semibold text-[#526070] no-underline sm:block\" data-kid=\"1-1-1-3-3\" data-name=\"log in link\" href=\"#\">\n                    Log in\n                </a>\n                <a class=\"focus-ring hidden rounded-lg bg-[#1B2A4A] px-4 py-2.5 text-[14px] font-semibold text-white no-underline shadow-sm hover:bg-[#0F1B33] sm:block\" data-kid=\"1-1-1-3-4\" data-name=\"sign up link\" href=\"#\">\n                    Sign up\n                </a>\n                <button aria-label=\"Open menu\" class=\"focus-ring flex h-10 w-10 items-center justify-center rounded-lg text-[#1B2A4A] hover:bg-[#EEF4F3] md:hidden\" data-kid=\"1-1-1-3-5\" data-name=\"mobile menu button\">\n                    <i class=\"h-5 w-5\" data-kid=\"1-1-1-3-5-1\" data-lucide=\"menu\" data-name=\"menu hamburger icon\">\n                    </i>\n                </button>\n            </div>\n        </div>\n    </header>\n    <main data-kid=\"1-2\" data-name=\"main content area\">\n        <section aria-labelledby=\"hero-title\" class=\"bg-[#1B2A4A] text-white\" data-kid=\"1-2-1\" data-name=\"hero section\">\n            <div class=\"mx-auto max-w-[1200px] px-8 pb-12 pt-9\" data-kid=\"1-2-1-1\" data-name=\"hero content wrapper\">\n                <div class=\"flex items-center justify-between gap-6 border-b border-white/15 pb-5\" data-kid=\"1-2-1-1-1\" data-name=\"hero header bar\">\n                    <div class=\"flex items-center gap-2 text-[13px] text-[#DCE7EA]\" data-kid=\"1-2-1-1-1-1\" data-name=\"university context container\">\n                        <span class=\"flex h-7 w-7 items-center justify-center rounded-lg bg-white/10\" data-kid=\"1-2-1-1-1-1-1\" data-name=\"map pin icon container\">\n                            <i class=\"h-3.5 w-3.5 text-[#4DD4D9]\" data-kid=\"1-2-1-1-1-1-1-1\" data-lucide=\"map-pin\" data-name=\"map pin icon\">\n                            </i>\n                        </span>\n                        <span data-kid=\"1-2-1-1-1-1-2\" data-name=\"university name label text\">\n                            Viewing the catalogue for\n                            <strong class=\"font-semibold text-white\" data-kid=\"1-2-1-1-1-1-2-1\" data-name=\"university name\">\n                                The University of Bamenda\n                            </strong>\n                        </span>\n                    </div>\n                    <div class=\"hidden items-center gap-5 text-[12px] text-[#B9C7D2] sm:flex\" data-kid=\"1-2-1-1-1-2\" data-name=\"status bar container\">\n                        <span class=\"flex items-center gap-2\" data-kid=\"1-2-1-1-1-2-1\" data-name=\"status indicator container\">\n                            <span class=\"h-2 w-2 rounded-full bg-[#2ECC71]\" data-kid=\"1-2-1-1-1-2-1-1\" data-name=\"online status dot\">\n                            </span>\n                            Catalogue available\n                        </span>\n                        <span data-kid=\"1-2-1-1-1-2-2\" data-name=\"academic year text\">\n                            Academic year 2026/27\n                        </span>\n                    </div>\n                </div>\n                <div class=\"grid gap-12 pb-4 pt-12 lg:grid-cols-[1.05fr_.95fr] lg:items-end\" data-kid=\"1-2-1-1-2\" data-name=\"hero body grid\">\n                    <div data-kid=\"1-2-1-1-2-1\" data-name=\"hero primary content block\">\n                        <p class=\"eyebrow text-[11px] font-semibold text-[#67D9DB]\" data-kid=\"1-2-1-1-2-1-1\" data-name=\"hero eyebrow text\">\n                            Academic programme discovery\n                        </p>\n                        <h1 class=\"mt-5 max-w-[650px] text-[52px] font-bold leading-[1.02] tracking-[-0.055em] text-[#FFFDF9]\" data-kid=\"1-2-1-1-2-1-2\" data-name=\"hero headline\" id=\"hero-title\">\n                            Find a programme that fits your next step.\n                        </h1>\n                        <p class=\"mt-6 max-w-[560px] text-[17px] leading-7 text-[#C7D3DD]\" data-kid=\"1-2-1-1-2-1-3\" data-name=\"hero description text\">\n                            Browse listed programmes, check the requirements you meet, and make a more informed choice before you apply.\n                        </p>\n                        <div class=\"mt-8 flex flex-wrap items-center gap-3 text-[13px] text-[#C7D3DD]\" data-kid=\"1-2-1-1-2-1-4\" data-name=\"hero feature list container\">\n                            <span class=\"flex items-center gap-2\" data-kid=\"1-2-1-1-2-1-4-1\" data-name=\"search feature point\">\n                                <i class=\"h-4 w-4 text-[#4DD4D9]\" data-kid=\"1-2-1-1-2-1-4-1-1\" data-lucide=\"check-circle-2\" data-name=\"check circle icon\">\n                                </i>\n                                Search by programme, subject, or career\n                            </span>\n                            <span class=\"hidden h-1 w-1 rounded-full bg-[#6B7E8D] sm:block\" data-kid=\"1-2-1-1-2-1-4-2\" data-name=\"list separator dot\">\n                            </span>\n                            <span class=\"flex items-center gap-2\" data-kid=\"1-2-1-1-2-1-4-3\" data-name=\"eligibility feature point\">\n                                <i class=\"h-4 w-4 text-[#F5A623]\" data-kid=\"1-2-1-1-2-1-4-3-1\" data-lucide=\"shield-check\" data-name=\"shield check icon\">\n                                </i>\n                                Guidance based on listed requirements\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"rounded-[18px] border border-white/15 bg-[#243757] p-5 shadow-[0_14px_28px_rgba(8,19,39,.18)]\" data-kid=\"1-2-1-1-2-2\" data-name=\"catalogue search card\">\n                        <div class=\"flex items-start justify-between gap-5\" data-kid=\"1-2-1-1-2-2-1\" data-name=\"card header\">\n                            <div data-kid=\"1-2-1-1-2-2-1-1\" data-name=\"card header text container\">\n                                <p class=\"text-[12px] font-semibold text-[#B9C7D2]\" data-kid=\"1-2-1-1-2-2-1-1-1\" data-name=\"card subtitle\">\n                                    Start with the catalogue\n                                </p>\n                                <p class=\"mt-1 text-[15px] font-semibold text-white\" data-kid=\"1-2-1-1-2-2-1-1-2\" data-name=\"card title\">\n                                    What are you looking for?\n                                </p>\n                            </div>\n                            <span class=\"flex items-center gap-1.5 rounded-full border border-[#3F5879] px-2.5 py-1 text-[11px] font-semibold text-[#D5E1E6]\" data-kid=\"1-2-1-1-2-2-1-2\" data-name=\"listed count badge\">\n                                <i class=\"h-3 w-3 text-[#4DD4D9]\" data-kid=\"1-2-1-1-2-2-1-2-1\" data-lucide=\"database\" data-name=\"database icon\">\n                                </i>\n                                435 listed\n                            </span>\n                        </div>\n                        <div class=\"mt-5 flex items-center gap-2 rounded-xl border border-white/15 bg-[#172B4A] px-3 py-2.5\" data-kid=\"1-2-1-1-2-2-2\" data-name=\"search input simulation container\">\n                            <i class=\"h-5 w-5 shrink-0 text-[#8EA1B0]\" data-kid=\"1-2-1-1-2-2-2-1\" data-lucide=\"search\" data-name=\"search icon\">\n                            </i>\n                            <span class=\"flex-1 text-[14px] text-[#8EA1B0]\" data-kid=\"1-2-1-1-2-2-2-2\" data-name=\"placeholder search text\">\n                                Search programmes, subjects, or careers…\n                            </span>\n                            <button class=\"focus-ring flex shrink-0 items-center gap-2 rounded-lg bg-[#0FA3B1] px-3.5 py-2 text-[13px] font-bold text-white hover:bg-[#0C8793]\" data-kid=\"1-2-1-1-2-2-2-3\" data-name=\"search action button\">\n                                Find programmes\n                                <i class=\"h-3.5 w-3.5\" data-kid=\"1-2-1-1-2-2-2-3-1\" data-lucide=\"arrow-up-right\" data-name=\"arrow up right icon\">\n                                </i>\n                            </button>\n                        </div>\n                        <div class=\"mt-4 flex flex-wrap gap-2\" data-kid=\"1-2-1-1-2-2-3\" data-name=\"suggested search tags container\">\n                            <span class=\"rounded-lg border border-[#3F5879] bg-[#2C4161] px-3 py-2 text-[12px] font-medium text-[#D5E1E6]\" data-kid=\"1-2-1-1-2-2-3-1\" data-name=\"computer science tag\">\n                                Computer science\n                            </span>\n                            <span class=\"rounded-lg border border-[#3F5879] bg-[#2C4161] px-3 py-2 text-[12px] font-medium text-[#D5E1E6]\" data-kid=\"1-2-1-1-2-2-3-2\" data-name=\"business tag\">\n                                Business\n                            </span>\n                            <span class=\"rounded-lg border border-[#3F5879] bg-[#2C4161] px-3 py-2 text-[12px] font-medium text-[#D5E1E6]\" data-kid=\"1-2-1-1-2-2-3-3\" data-name=\"health sciences tag\">\n                                Health sciences\n                            </span>\n                            <span class=\"rounded-lg border border-[#3F5879] bg-[#2C4161] px-3 py-2 text-[12px] font-medium text-[#D5E1E6]\" data-kid=\"1-2-1-1-2-2-3-4\" data-name=\"browse all tag\">\n                                Browse all\n                            </span>\n                        </div>\n                        <div class=\"mt-5 flex items-center justify-between border-t border-white/10 pt-4 text-[12px]\" data-kid=\"1-2-1-1-2-2-4\" data-name=\"card footer\">\n                            <span class=\"text-[#9FB0BC]\" data-kid=\"1-2-1-1-2-2-4-1\" data-name=\"footer help text\">\n                                Or start with your results\n                            </span>\n                            <a class=\"flex items-center gap-1.5 font-semibold text-[#67D9DB] no-underline\" data-kid=\"1-2-1-1-2-2-4-2\" data-name=\"check eligibility link\" href=\"#eligibility\">\n                                Check eligibility\n                                <i class=\"h-3.5 w-3.5\" data-kid=\"1-2-1-1-2-2-4-2-1\" data-lucide=\"arrow-right\" data-name=\"arrow right icon\">\n                                </i>\n                            </a>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"mt-10 grid grid-cols-3 gap-0 border-t border-white/15 pt-5 sm:grid-cols-4\" data-kid=\"1-2-1-1-3\" data-name=\"hero stats grid\">\n                    <div class=\"border-r border-white/15 pr-5\" data-kid=\"1-2-1-1-3-1\" data-name=\"stat item\">\n                        <p class=\"tabular text-[28px] font-bold tracking-[-0.04em] text-white\" data-kid=\"1-2-1-1-3-1-1\" data-name=\"stat value\">\n                            435\n                        </p>\n                        <p class=\"mt-1 text-[12px] text-[#B9C7D2]\" data-kid=\"1-2-1-1-3-1-2\" data-name=\"stat label\">\n                            listed programmes\n                        </p>\n                    </div>\n                    <div class=\"border-r border-white/15 px-5\" data-kid=\"1-2-1-1-3-2\" data-name=\"stat item\">\n                        <p class=\"tabular text-[28px] font-bold tracking-[-0.04em] text-white\" data-kid=\"1-2-1-1-3-2-1\" data-name=\"stat value\">\n                            9\n                        </p>\n                        <p class=\"mt-1 text-[12px] text-[#B9C7D2]\" data-kid=\"1-2-1-1-3-2-2\" data-name=\"stat label\">\n                            faculties & schools\n                        </p>\n                    </div>\n                    <div class=\"border-r border-white/15 px-5\" data-kid=\"1-2-1-1-3-3\" data-name=\"stat item\">\n                        <p class=\"tabular text-[28px] font-bold tracking-[-0.04em] text-white\" data-kid=\"1-2-1-1-3-3-1\" data-name=\"stat value\">\n                            2026/27\n                        </p>\n                        <p class=\"mt-1 text-[12px] text-[#B9C7D2]\" data-kid=\"1-2-1-1-3-3-2\" data-name=\"stat label\">\n                            latest tuition year\n                        </p>\n                    </div>\n                    <div class=\"hidden pl-5 sm:block\" data-kid=\"1-2-1-1-3-4\" data-name=\"stat item\">\n                        <p class=\"text-[28px] font-bold tracking-[-0.04em] text-[#4DD4D9]\" data-kid=\"1-2-1-1-3-4-1\" data-name=\"stat value\">\n                            Free\n                        </p>\n                        <p class=\"mt-1 text-[12px] text-[#B9C7D2]\" data-kid=\"1-2-1-1-3-4-2\" data-name=\"stat label\">\n                            to browse and check\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"how-title\" class=\"border-b border-[#E2E2DD] bg-[#FFFDF9] py-12\" data-kid=\"1-2-2\" data-name=\"how it works section\">\n            <div class=\"mx-auto max-w-[1200px] px-8\" data-kid=\"1-2-2-1\" data-name=\"section container\">\n                <div class=\"flex flex-col justify-between gap-4 sm:flex-row sm:items-end\" data-kid=\"1-2-2-1-1\" data-name=\"section header\">\n                    <div data-kid=\"1-2-2-1-1-1\" data-name=\"section header text container\">\n                        <p class=\"eyebrow text-[11px] font-semibold text-[#0FA3B1]\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"section eyebrow text\">\n                            A clearer route through the catalogue\n                        </p>\n                        <h2 class=\"mt-3 text-[29px] font-bold tracking-[-0.04em] text-[#17233D]\" data-kid=\"1-2-2-1-1-1-2\" data-name=\"section title\" id=\"how-title\">\n                            How it works\n                        </h2>\n                    </div>\n                    <p class=\"max-w-[420px] text-[14px] leading-6 text-[#526070]\" data-kid=\"1-2-2-1-1-2\" data-name=\"section description text\">\n                        Your route changes depending on what you already know. Start with a programme, or let your subjects narrow the field.\n                    </p>\n                </div>\n                <div class=\"mt-8 grid gap-4 lg:grid-cols-[1fr_auto_1fr_auto_1fr] lg:items-stretch\" data-kid=\"1-2-2-1-2\" data-name=\"steps grid container\">\n                    <div class=\"border-l-2 border-[#0FA3B1] pl-4\" data-kid=\"1-2-2-1-2-1\" data-name=\"step 1 card\">\n                        <p class=\"text-[11px] font-bold text-[#0FA3B1]\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"step label\">\n                            01 · Choose a starting point\n                        </p>\n                        <h3 class=\"mt-2 text-[16px] font-bold text-[#17233D]\" data-kid=\"1-2-2-1-2-1-2\" data-name=\"step title\">\n                            Browse or search\n                        </h3>\n                        <p class=\"mt-2 text-[13px] leading-5 text-[#526070]\" data-kid=\"1-2-2-1-2-1-3\" data-name=\"step description\">\n                            Use programme names, subject areas, faculties, or careers to begin.\n                        </p>\n                    </div>\n                    <div class=\"hidden items-center justify-center text-[#A6B0B7] lg:flex\" data-kid=\"1-2-2-1-2-2\" data-name=\"step 1 to 2 arrow container\">\n                        <i class=\"h-5 w-5\" data-kid=\"1-2-2-1-2-2-1\" data-lucide=\"arrow-right\" data-name=\"arrow icon\">\n                        </i>\n                    </div>\n                    <div class=\"border-l-2 border-[#F5A623] pl-4\" data-kid=\"1-2-2-1-2-3\" data-name=\"step 2 card\">\n                        <p class=\"text-[11px] font-bold text-[#B66D08]\" data-kid=\"1-2-2-1-2-3-1\" data-name=\"step label\">\n                            02 · Pick your applicant path\n                        </p>\n                        <div class=\"mt-2 flex flex-wrap gap-2\" data-kid=\"1-2-2-1-2-3-2\" data-name=\"applicant path tags container\">\n                            <span class=\"rounded-md bg-[#EDF5F4] px-2 py-1 text-[12px] font-semibold text-[#1B2A4A]\" data-kid=\"1-2-2-1-2-3-2-1\" data-name=\"undergraduate tag\">\n                                Undergraduate\n                            </span>\n                            <span class=\"rounded-md bg-[#FFF4DD] px-2 py-1 text-[12px] font-semibold text-[#7B4F0B]\" data-kid=\"1-2-2-1-2-3-2-2\" data-name=\"postgraduate tag\">\n                                Postgraduate\n                            </span>\n                        </div>\n                        <p class=\"mt-2 text-[13px] leading-5 text-[#526070]\" data-kid=\"1-2-2-1-2-3-3\" data-name=\"step description\">\n                            Enter the subjects or previous degree information that applies to you.\n                        </p>\n                    </div>\n                    <div class=\"hidden items-center justify-center text-[#A6B0B7] lg:flex\" data-kid=\"1-2-2-1-2-4\" data-name=\"step 2 to 3 arrow container\">\n                        <i class=\"h-5 w-5\" data-kid=\"1-2-2-1-2-4-1\" data-lucide=\"arrow-right\" data-name=\"arrow icon\">\n                        </i>\n                    </div>\n                    <div class=\"border-l-2 border-[#2ECC71] pl-4\" data-kid=\"1-2-2-1-2-5\" data-name=\"step 3 card\">\n                        <p class=\"text-[11px] font-bold text-[#218A4D]\" data-kid=\"1-2-2-1-2-5-1\" data-name=\"step label\">\n                            03 · Review before you decide\n                        </p>\n                        <h3 class=\"mt-2 text-[16px] font-bold text-[#17233D]\" data-kid=\"1-2-2-1-2-5-2\" data-name=\"step title\">\n                            Check the evidence\n                        </h3>\n                        <p class=\"mt-2 text-[13px] leading-5 text-[#526070]\" data-kid=\"1-2-2-1-2-5-3\" data-name=\"step description\">\n                            See listed requirements, tuition context, and the next programme detail to verify.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"programme-title\" class=\"py-14\" data-kid=\"1-2-3\" data-name=\"featured programmes section\" id=\"programmes\">\n            <div class=\"mx-auto max-w-[1200px] px-8\" data-kid=\"1-2-3-1\" data-name=\"section container\">\n                <div class=\"flex flex-col justify-betw