generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model University {
  id            String         @id @default(cuid())
  name          String
  abbreviation  String         @unique
  website       String?
  description   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  academicUnits AcademicUnit[]
}

model AcademicUnit {
  id           String           @id @default(cuid())
  universityId String
  name         String
  abbreviation String?
  type         AcademicUnitType
  description  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  university   University       @relation(fields: [universityId], references: [id], onDelete: Cascade)
  departments  Department[]

  @@unique([universityId, name])
}

model Department {
  id             String       @id @default(cuid())
  academicUnitId String
  name           String
  abbreviation   String?
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  academicUnit   AcademicUnit @relation(fields: [academicUnitId], references: [id], onDelete: Cascade)
  programmes     Programme[]

  @@unique([academicUnitId, name])
}

model Programme {
  id           String                 @id @default(cuid())
  departmentId String
  code         String                 @unique
  sourceCode   String?
  name         String
  degree       DegreeType
  level        ProgrammeLevel
  duration     Int
  description  String?
  awardType    String?
  entryRequirements String?
  applicationDeadline DateTime?
  applicationStatus   String?
  applicationCycle    String?
  sourceDocument      String?
  sourceImportedAt    DateTime?
  needsReview         Boolean                @default(false)
  reviewNotes         String?
  isActive     Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  department   Department             @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  requirements    ProgrammeRequirement[]
  admissionRules  ProgrammeAdmissionRule[]
  tuition         Tuition[]
  careers         ProgrammeCareer[]
  keywords        ProgrammeKeyword[]
  savedProgrammes SavedProgramme[]
  announcements   Announcement[]

  @@index([name])
}

model Tuition {
  id           String    @id @default(cuid())
  programmeId  String
  academicYear String
  amount       Decimal   @db.Decimal(12, 2)
  currency     String    @default("XAF")
  feePeriod    FeePeriod @default(UNKNOWN)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  programme    Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  @@unique([programmeId, academicYear])
}

model ProgrammeAdmissionRule {
  id          String                @id @default(cuid())
  programmeId String
  category    AdmissionRuleCategory
  text        String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  programme   Programme             @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  @@unique([programmeId, category, text])
}

model Subject {
  id           String                 @id @default(cuid())
  name         String                 @unique
  code         String?
  level        SubjectLevel
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  requirements ProgrammeRequirement[]
}

model ProgrammeRequirement {
  id              String          @id @default(cuid())
  programmeId     String
  subjectId       String
  requirementType RequirementType
  minimumGrade    String?
  programme       Programme       @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  subject         Subject         @relation(fields: [subjectId], references: [id])

  @@unique([programmeId, subjectId])
}

model Career {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  programmes  ProgrammeCareer[]
}

model ProgrammeCareer {
  programmeId  String
  careerId     String
  programme    Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  career       Career    @relation(fields: [careerId], references: [id])

  @@id([programmeId, careerId])
}

model Keyword {
  id          String             @id @default(cuid())
  word        String             @unique
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  programmes  ProgrammeKeyword[]
}

model ProgrammeKeyword {
  programmeId  String
  keywordId    String
  programme    Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  keyword      Keyword   @relation(fields: [keywordId], references: [id])

  @@id([programmeId, keywordId])
}

model User {
  id              String          @id @default(cuid())
  email           String          @unique
  passwordHash    String
  firstName       String
  lastName        String
  role            UserRole        @default(VISITOR)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  savedProgrammes SavedProgramme[]
  searchHistory   SearchHistory[]
  announcements   Announcement[]
}

model SavedProgramme {
  id          String    @id @default(cuid())
  userId      String
  programmeId String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  @@unique([userId, programmeId])
}

model SearchHistory {
  id          String   @id @default(cuid())
  userId      String?
  query       String
  filters     Json?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  content     String
  programmeId String?
  authorId    String
  published   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  programme   Programme? @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  author      User      @relation(fields: [authorId], references: [id])
}

model GeneralAdmissionRule {
  id          String   @id @default(cuid())
  title       String
  description String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum AcademicUnitType {
  FACULTY
  SCHOOL
}

enum DegreeType {
  BSC
  BA
  BENG
  BED
  LLB
  MBBS
  HND
  DIPLOMA
  PGD
  MSC
  MA
  MENG
  PHD
  CERTIFICATE
  BTECH
  HPD
}

enum ProgrammeLevel {
  UNDERGRADUATE
  POSTGRADUATE
  DOCTORATE
  PROFESSIONAL
}

enum SubjectLevel {
  O_LEVEL
  A_LEVEL
}

enum RequirementType {
  REQUIRED
  OPTIONAL
}

enum FeePeriod {
  ANNUAL
  PROGRAMME_TOTAL
  FIRST_YEAR
  UNKNOWN
}

enum AdmissionRuleCategory {
  O_LEVEL
  A_LEVEL
  QUALIFICATION
  ENTRANCE_EXAM
  EQUIVALENCY
}

enum UserRole {
  VISITOR
  STUDENT
  ADMIN
}
