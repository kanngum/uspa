generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model University {
  id            String         @id @default(cuid())
  name          String
  abbreviation  String         @unique
  website       String?
  description   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  academicUnits AcademicUnit[]
}

model AcademicUnit {
  id           String           @id @default(cuid())
  universityId String
  name         String
  abbreviation String?
  type         AcademicUnitType
  description  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  university   University       @relation(fields: [universityId], references: [id], onDelete: Cascade)
  departments  Department[]

  @@unique([universityId, name])
}

model Department {
  id             String       @id @default(cuid())
  academicUnitId String
  name           String
  abbreviation   String?
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  academicUnit   AcademicUnit @relation(fields: [academicUnitId], references: [id], onDelete: Cascade)
  programmes     Programme[]

  @@unique([academicUnitId, name])
}

model Programme {
  id           String                 @id @default(cuid())
  departmentId String
  code         String                 @unique
  name         String
  degree       DegreeType
  level        ProgrammeLevel
  duration     Int
  description  String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  department   Department             @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  requirements ProgrammeRequirement[]
  tuition      Tuition[]

  @@index([name])
}

model Tuition {
  id           String    @id @default(cuid())
  programmeId  String
  academicYear String
  amount       Decimal   @db.Decimal(12, 2)
  currency     String    @default("XAF")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  programme    Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  @@unique([programmeId, academicYear])
}

model Subject {
  id           String                 @id @default(cuid())
  name         String                 @unique
  level        SubjectLevel
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  requirements ProgrammeRequirement[]
}

model ProgrammeRequirement {
  id              String          @id @default(cuid())
  programmeId     String
  subjectId       String
  requirementType RequirementType
  minimumGrade    String?
  programme       Programme       @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  subject         Subject         @relation(fields: [subjectId], references: [id])

  @@unique([programmeId, subjectId])
}

model GeneralAdmissionRule {
  id          String   @id @default(cuid())
  title       String
  description String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum AcademicUnitType {
  FACULTY
  SCHOOL
}

enum DegreeType {
  BSC
  BA
  BENG
  BED
  LLB
  MBBS
  HND
  DIPLOMA
  PGD
  MSC
  MA
  MENG
  PHD
}

enum ProgrammeLevel {
  UNDERGRADUATE
  POSTGRADUATE
  DOCTORATE
  PROFESSIONAL
}

enum SubjectLevel {
  O_LEVEL
  A_LEVEL
}

enum RequirementType {
  REQUIRED
  OPTIONAL
}
