generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////

enum AcademicUnitType {
  FACULTY
  SCHOOL
}

enum DegreeType {
  BSC
  BA
  BENG
  BED
  LLB
  MBBS
  HND
  DIPLOMA
  PGD
  MSC
  MA
  MENG
  PHD
}

enum ProgrammeLevel {
  UNDERGRADUATE
  POSTGRADUATE
  DOCTORATE
  PROFESSIONAL
}

enum SubjectLevel {
  O_LEVEL
  A_LEVEL
}

enum RequirementType {
  REQUIRED
  OPTIONAL
}

enum UserRole {
  STUDENT
  FACULTY_ADMIN
  ADMISSIONS_OFFICER
  SUPER_ADMIN
}

enum RuleEntityType {
  UNIVERSITY
  FACULTY
  DEPARTMENT
  PROGRAMME
}

enum RuleOperator {
  MIN_SUBJECTS
  MIN_GRADE
  REQUIRED_SUBJECT
  OPTIONAL_SUBJECT
  MIN_PASSES
  SPECIFIC_GRADE_IN
  SUBJECT_COMBINATION
}

enum EligibilityStatus {
  ELIGIBLE
  CONDITIONALLY_ELIGIBLE
  NOT_ELIGIBLE
}

//////////////////////////////////////////////////
// UNIVERSITY
//////////////////////////////////////////////////

model University {
  id           String  @id @default(uuid())
  name         String
  abbreviation String  @unique
  website      String?
  description  String?

  academicUnits AcademicUnit[]
  admissionRules AdmissionRule[]
  announcements Announcement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////
// ACADEMIC UNITS (Faculties/Schools)
//////////////////////////////////////////////////

model AcademicUnit {
  id String @id @default(uuid())

  universityId String

  name String

  abbreviation String?

  type AcademicUnitType

  description String?

  university University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  departments Department[]
  admissionRules AdmissionRule[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([universityId, name])
}

//////////////////////////////////////////////////
// DEPARTMENTS
//////////////////////////////////////////////////

model Department {
  id String @id @default(uuid())

  academicUnitId String

  name String

  abbreviation String?

  description String?

  academicUnit AcademicUnit @relation(fields: [academicUnitId], references: [id], onDelete: Cascade)

  programmes Programme[]
  admissionRules AdmissionRule[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([academicUnitId, name])
}

//////////////////////////////////////////////////
// PROGRAMMES
//////////////////////////////////////////////////

model Programme {
  id String @id @default(uuid())

  departmentId String

  code String @unique

  name String

  degree DegreeType

  level ProgrammeLevel

  duration Int

  description String?

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  requirements ProgrammeRequirement[]
  tuition Tuition[]
  careers ProgrammeCareer[]
  keywords ProgrammeKeyword[]
  admissionRules AdmissionRule[]
  savedProgrammes SavedProgramme[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([name])
}

//////////////////////////////////////////////////
// SUBJECTS (O/A Level)
//////////////////////////////////////////////////

model Subject {
  id String @id @default(uuid())

  name String @unique

  level SubjectLevel

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  requirements ProgrammeRequirement[]
}

//////////////////////////////////////////////////
// PROGRAMME REQUIREMENTS
//////////////////////////////////////////////////

model ProgrammeRequirement {
  id String @id @default(uuid())

  programmeId String

  subjectId String

  requirementType RequirementType

  minimumGrade String?

  programme Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([programmeId, subjectId])
}

//////////////////////////////////////////////////
// CAREERS
//////////////////////////////////////////////////

model Career {
  id          String @id @default(uuid())
  name        String @unique
  description String?

  programmes ProgrammeCareer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProgrammeCareer {
  programmeId String
  careerId    String

  programme Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  career    Career    @relation(fields: [careerId], references: [id], onDelete: Cascade)

  @@id([programmeId, careerId])
}

//////////////////////////////////////////////////
// KEYWORDS (Search)
//////////////////////////////////////////////////

model Keyword {
  id   String @id @default(uuid())
  word String @unique

  programmes ProgrammeKeyword[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProgrammeKeyword {
  programmeId String
  keywordId   String

  programme Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  keyword   Keyword   @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@id([programmeId, keywordId])
}

//////////////////////////////////////////////////
// GENERAL ADMISSION RULES
//////////////////////////////////////////////////

model GeneralAdmissionRule {
  id String @id @default(uuid())

  title String

  description String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////
// STRUCTURED ADMISSION RULES (Rule Engine)
//////////////////////////////////////////////////

model AdmissionRule {
  id              String         @id @default(uuid())
  entityType      RuleEntityType
  universityId    String?
  academicUnitId  String?
  departmentId    String?
  programmeId     String?
  priority        Int            @default(0)
  description     String?
  isActive        Boolean        @default(true)

  university   University?   @relation(fields: [universityId], references: [id], onDelete: Cascade)
  academicUnit AcademicUnit? @relation(fields: [academicUnitId], references: [id], onDelete: Cascade)
  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  programme    Programme?    @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  conditions RuleCondition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityType, isActive])
}

model RuleCondition {
  id            String       @id @default(uuid())
  admissionRuleId String
  operator      RuleOperator
  field         String?
  value         String       // JSON value for the condition
  description   String?

  rule AdmissionRule @relation(fields: [admissionRuleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////
// TUITION
//////////////////////////////////////////////////

model Tuition {
  id String @id @default(uuid())

  programmeId String

  academicYear String

  amount Decimal @db.Decimal(12, 2)

  currency String @default("XAF")

  programme Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([programmeId, academicYear])
}

//////////////////////////////////////////////////
// USERS & AUTHENTICATION
//////////////////////////////////////////////////

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String
  firstName      String
  lastName       String
  role           UserRole @default(STUDENT)
  isActive       Boolean  @default(true)

  savedProgrammes  SavedProgramme[]
  searchHistory    SearchHistory[]
  announcements    Announcement[]   @relation("createdByUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([role])
}

//////////////////////////////////////////////////
// SAVED PROGRAMMES
//////////////////////////////////////////////////

model SavedProgramme {
  id          String   @id @default(uuid())
  userId      String
  programmeId String

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  programme Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, programmeId])
}

//////////////////////////////////////////////////
// SEARCH HISTORY
//////////////////////////////////////////////////

model SearchHistory {
  id        String   @id @default(uuid())
  userId    String?
  query     String
  filters   String?  // JSON of applied filters
  resultsCount Int?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

//////////////////////////////////////////////////
// ANNOUNCEMENTS
//////////////////////////////////////////////////

model Announcement {
  id         String   @id @default(uuid())
  title      String
  content    String
  published  Boolean  @default(false)
  authorId   String

  author     User       @relation("createdByUser", fields: [authorId], references: [id])
  universityId String?
  university University? @relation(fields: [universityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, createdAt])
}

//////////////////////////////////////////////////
// AUDIT LOGS
//////////////////////////////////////////////////

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String?
  userId     String?
  metadata   String?  // JSON additional data

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}
